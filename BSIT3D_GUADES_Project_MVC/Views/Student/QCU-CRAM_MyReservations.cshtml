@model BSIT3D_GUADES_Project_MVC.QCUCRAM_ViewModels.QCUCRAMMyReservationsViewModel
@using System
@{
    /* =====================================================================
       QCU-CRAM  |  Views/Student/QCU-CRAM_MyReservations.cshtml
       ---------------------------------------------------------------------
       Port of Guades_QCUCram_Student/Guades_QCUCram_MyReservations.aspx.

       Phase 13 corrections (all from the .aspx / .aspx.cs):
         - date column  "ddd, MMM d, yyyy"; members column is the bare number
         - status badge is  <span class="badge text-bg-*">  with the raw status text
         - Cancel opens the qcuConfirm pop-up (not window.confirm)
         - Print opens the content modal (data-qcu-load)
         - "request #N was submitted" is a toast (set by the controller), not an inline alert
         - empty state is the GridView EmptyDataText table
         - numeric pager (10 page buttons, "..." blocks) in the qcu-pager row
       ===================================================================== */

    ViewBag.Title = "My Reservations";

    var pager = Model.Pager;
    int colCount = 8;
}

<div class="qcu-page-head">
    <h2>My Reservations</h2>
    <p>Track, print or cancel your room requests</p>
</div>

<div class="qcu-toolbar row g-2 align-items-end mb-3">

    <div class="col-auto">
        <label class="form-label" for="qcuStatusFilter">Filter by status</label>
        <form method="get" action="@Url.Action("MyReservations", "Student")" class="d-flex gap-2">
            <select id="qcuStatusFilter" name="status" class="form-select" onchange="this.form.submit()">
                <option value="" selected="@(string.IsNullOrWhiteSpace(Model.StatusFilter) ? "selected" : null)">All statuses</option>
                @foreach (var status in Model.StatusChoices)
                {
                    <option value="@status" selected="@(status == Model.StatusFilter ? "selected" : null)">@status</option>
                }
            </select>
        </form>
    </div>

    <div class="col-auto">
        <a class="btn btn-primary" href="@Url.Action("Reserve", "Student")">New reservation</a>
    </div>

</div>

<div class="table-responsive">
    @if (Model.IsEmpty)
    {
        @* GridView EmptyDataText: a one-cell table, no header row *@
        <table class="table table-bordered table-striped align-middle">
            <tbody>
                <tr>
                    <td>You have no reservations to show.</td>
                </tr>
            </tbody>
        </table>
    }
    else
    {
        <table class="table table-bordered table-striped align-middle">
            <thead>
                <tr>
                    <th scope="col">#</th>
                    <th scope="col">Date</th>
                    <th scope="col">Time</th>
                    <th scope="col">Room</th>
                    <th scope="col">Members</th>
                    <th scope="col">Purpose</th>
                    <th scope="col">Status</th>
                    <th scope="col">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Items)
                {
                    var item = row.Item;
                    if (item == null) { continue; }

                    <tr>
                        <td>@item.ReservationId</td>
                        <td>@row.DateLabel</td>
                        <td>@item.SlotLabel</td>
                        <td>@item.RoomName</td>
                        <td>@row.MembersLabel</td>
                        <td>@item.Purpose</td>
                        <td><span class="badge @row.BadgeCss">@row.StatusLabel</span></td>
                        <td>
                            @if (row.CanCancel)
                            {
                                using (Html.BeginForm("Cancel", "Student", FormMethod.Post, new { @class = "d-inline" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@row.ReservationId" />
                                    <input type="hidden" name="status" value="@Model.StatusFilter" />
                                    <input type="hidden" name="page" value="@(pager == null ? 1 : pager.Page)" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger"
                                            onclick="return qcuConfirm(this, { tone: 'warning', title: 'Cancel this reservation?', message: 'The room and time slot are released. This cannot be undone.', confirmText: 'Cancel reservation', cancelText: 'Keep reservation' });">Cancel</button>
                                }
                            }
                            <a class="btn btn-sm btn-outline-secondary" data-qcu-load="1"
                               data-qcu-load-title="Reservation #@row.ReservationId"
                               href="@Url.Action("PrintBooking", "Reports", new { id = row.ReservationId })">Print</a>
                        </td>
                    </tr>
                }

                @if (pager != null && pager.HasPages)
                {
                    @* GridView numeric pager: PageButtonCount = 10, "..." jumps to the neighbouring block *@
                    int total = pager.TotalPages;
                    int current = pager.Page < 1 ? 1 : (pager.Page > total ? total : pager.Page);
                    int blockSize = 10;
                    int first = ((current - 1) / blockSize) * blockSize + 1;
                    int last = Math.Min(first + blockSize - 1, total);

                    <tr class="qcu-pager" align="center">
                        <td colspan="@colCount">
                            <table>
                                <tbody>
                                    <tr>
                                        @if (first > 1)
                                        {
                                            <td><a href="@pager.UrlFor(first - 1)">...</a></td>
                                        }
                                        @for (int p = first; p <= last; p++)
                                        {
                                            if (p == current)
                                            {
                                                <td><span>@p</span></td>
                                            }
                                            else
                                            {
                                                <td><a href="@pager.UrlFor(p)">@p</a></td>
                                            }
                                        }
                                        @if (last < total)
                                        {
                                            <td><a href="@pager.UrlFor(last + 1)">...</a></td>
                                        }
                                    </tr>
                                </tbody>
                            </table>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
