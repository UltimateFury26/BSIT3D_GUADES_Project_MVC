@model BSIT3D_GUADES_Project_MVC.QCUCRAM_ViewModels.QCUCRAMProfileViewModel
@using System
@{
    /* =====================================================================
       QCU-CRAM  |  Views/Student/QCU-CRAM_Profile.cshtml
       ---------------------------------------------------------------------
       Port of Guades_QCUCram_Student/Guades_QCUCram_Profile.aspx.

       Same cards, same order:
         booking standing banner   (litStanding)
         My details                (identity block + the editable fields)
         My reservation history    (litHistory summary table)
         Quick links
         Account security          (Change Password, which the original kept here
                                    rather than in the top navigation)
       ===================================================================== */

    ViewBag.Title = "My Profile";

    var stats = Model.Stats ?? new BSIT3D_GUADES_Project_MVC.QCUCRAM_ViewModels.QCUCRAMReservationStats();
    var standingClass = Model.Standing == "restricted" ? "alert-danger"
                      : Model.Standing == "warning" ? "alert-warning"
                      : "alert-success";
}

<div class="qcu-page-head">
    <h2>Profile</h2>
    <p>Your details, booking standing and history</p>
</div>

@Html.Partial("_QCU-CRAM_ValidationSummary")

@* ---- Booking standing ---- *@
<div class="alert @standingClass">
    @if (Model.Standing == "restricted")
    {
        <strong>Your account is restricted.</strong>
        <text>
            You cannot file new reservations
            @if (Model.RestrictionLiftDate.HasValue)
            {
                <text>until @Model.RestrictionLiftLabel.</text>
            }
            else
            {
                <text>until a library assistant lifts the restriction.</text>
            }
            You have @Model.NoShowCount no-show @(Model.NoShowCount == 1 ? "strike" : "strikes").
        </text>
    }
    else if (Model.Standing == "warning")
    {
        <strong>Careful.</strong>
        <text>
            You have @Model.NoShowCount no-show @(Model.NoShowCount == 1 ? "strike" : "strikes")
            out of @Model.NoShowThreshold. @Model.StrikesLeft more and your account is restricted
            for a week.
        </text>
    }
    else
    {
        <strong>Good standing.</strong>
        <text>You have no no-show strikes. Keep showing up for your bookings.</text>
    }
</div>

<div class="row g-4">

    @* ============ My details ============ *@
    <div class="col-lg-6">
        <div class="card">
            <div class="card-header"><strong>My details</strong></div>
            <div class="card-body">

                <div class="row mb-3">
                    <div class="col-sm-6">
                        <div class="text-muted small">ID / Student Number</div>
                        <div class="fw-bold">@Model.StudentNumber</div>
                    </div>
                    <div class="col-sm-6">
                        <div class="text-muted small">Requester type</div>
                        <div class="fw-bold">@Model.RequesterType</div>
                    </div>
                </div>
                <p class="text-muted small">
                    Your ID number and requester type can only be changed by a library assistant.
                </p>

                @using (Html.BeginForm("Profile", "Student", FormMethod.Post, new { @class = "qcu-formcard" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(m => m.StudentID)
                    @Html.HiddenFor(m => m.StudentNumber)
                    @Html.HiddenFor(m => m.RequesterType)

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label" for="LastName">Last Name</label>
                            @Html.TextBoxFor(m => m.LastName, new { @class = "form-control", maxlength = "60" })
                            @Html.ValidationMessageFor(m => m.LastName, null, new { @class = "text-danger small" })
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label" for="FirstName">First Name</label>
                            @Html.TextBoxFor(m => m.FirstName, new { @class = "form-control", maxlength = "60" })
                            @Html.ValidationMessageFor(m => m.FirstName, null, new { @class = "text-danger small" })
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="MI">Middle Initial (optional)</label>
                        @Html.TextBoxFor(m => m.MI, new { @class = "form-control", maxlength = "2", style = "max-width:100px" })
                        @Html.ValidationMessageFor(m => m.MI, null, new { @class = "text-danger small" })
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="Email">Email</label>
                        @Html.TextBoxFor(m => m.Email, new { @class = "form-control", maxlength = "120", type = "email" })
                        @Html.ValidationMessageFor(m => m.Email, null, new { @class = "text-danger small" })
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="Program">Program</label>
                        <select id="Program" name="Program" class="form-select">
                            <option value="">-- choose your program --</option>
                            @foreach (var program in Model.ProgramChoices)
                            {
                                <option value="@program" selected="@(program == Model.Program ? "selected" : null)">@program</option>
                            }
                        </select>
                        @Html.ValidationMessageFor(m => m.Program, null, new { @class = "text-danger small" })
                    </div>

                    <button type="submit" class="btn btn-primary"
                            onclick="this.disabled = true; this.innerHTML = 'Please wait...';">
                        Save Changes
                    </button>
                }
            </div>
        </div>
    </div>

    @* ============ History + links + security ============ *@
    <div class="col-lg-6">

        <div class="card mb-4">
            <div class="card-header"><strong>My reservation history</strong></div>
            <div class="card-body">
                @if (stats.Total == 0)
                {
                    <p class="text-muted mb-0">
                        You have not submitted a reservation yet.
                        <a href="@Url.Action("Reserve", "Student")">Reserve a room</a>.
                    </p>
                }
                else
                {
                    <table class="table table-sm table-bordered align-middle mb-0">
                        <tbody>
                            <tr>
                                <th scope="row">Total requests</th>
                                <td class="text-end">@stats.Total</td>
                            </tr>
                            <tr>
                                <th scope="row">Pending</th>
                                <td class="text-end">@stats.Pending</td>
                            </tr>
                            <tr>
                                <th scope="row">Approved</th>
                                <td class="text-end">@stats.Approved</td>
                            </tr>
                            <tr>
                                <th scope="row">Checked in</th>
                                <td class="text-end">@stats.CheckedIn</td>
                            </tr>
                            <tr>
                                <th scope="row">Completed</th>
                                <td class="text-end">@stats.Completed</td>
                            </tr>
                            <tr>
                                <th scope="row">Forfeited (no-show)</th>
                                <td class="text-end @(stats.Forfeited > 0 ? "text-danger fw-semibold" : null)">@stats.Forfeited</td>
                            </tr>
                            <tr>
                                <th scope="row">Cancelled</th>
                                <td class="text-end">@stats.Cancelled</td>
                            </tr>
                            <tr>
                                <th scope="row">Declined</th>
                                <td class="text-end">@stats.Declined</td>
                            </tr>
                        </tbody>
                    </table>
                }
            </div>
        </div>

        <div class="card">
            <div class="card-header"><strong>Quick links</strong></div>
            <div class="list-group list-group-flush">
                <a class="list-group-item list-group-item-action" href="@Url.Action("MyReservations", "Student")">My Reservations</a>
                <a class="list-group-item list-group-item-action" href="@Url.Action("Notifications", "Student")">Notifications</a>
                <a class="list-group-item list-group-item-action" href="@Url.Action("Index", "Availability")">Room Availability</a>
            </div>
        </div>

        @* ---- Account security: Change Password lives here ---- *@
        <div class="card mt-4">
            <div class="card-header"><strong>Account security</strong></div>
            <div class="card-body">
                <div class="mb-3">
                    <div class="fw-semibold">Password</div>
                    <div class="text-muted small">Change it regularly and never share it with anyone.</div>
                </div>

                <form method="post" action="@Url.Action("ChangePassword", "Student")" class="row g-2"
                      onsubmit="return confirm('Change your password now?');">
                    @Html.AntiForgeryToken()

                    <div class="col-md-4">
                        <label class="form-label" for="currentPassword">Current password</label>
                        <input type="password" id="currentPassword" name="currentPassword"
                               class="form-control" autocomplete="current-password" required />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="newPassword">New password</label>
                        <input type="password" id="newPassword" name="newPassword"
                               class="form-control" autocomplete="new-password" minlength="8" required />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="confirmPassword">Confirm new password</label>
                        <input type="password" id="confirmPassword" name="confirmPassword"
                               class="form-control" autocomplete="new-password" minlength="8" required />
                    </div>

                    <div class="col-12">
                        <div class="form-text">
                            At least 8 characters, with an uppercase letter, a lowercase letter,
                            a number and a symbol (for example ! @ # $ %).
                        </div>
                    </div>

                    <div class="col-12 mt-3">
                        <button type="submit" class="btn btn-outline-primary">Change Password</button>
                        <span class="text-muted small ms-2">At least 8 characters.</span>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
