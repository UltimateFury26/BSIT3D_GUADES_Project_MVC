@model BSIT3D_GUADES_Project_MVC.QCUCRAM_ViewModels.QCUCRAMReserveViewModel
@using System
@using System.Globalization
@{
    /* =====================================================================
       QCU-CRAM  |  Views/Student/QCU-CRAM_Reserve.cshtml
       ---------------------------------------------------------------------
       Port of Guades_QCUCram_Student/Guades_QCUCram_Reserve.aspx.

       The Web Forms page used a Repeater for the member rows and an
       AutoPostBack drop-down for "Number of members". Here the rows are
       plain inputs named Members[0].LastName, Members[1].LastName, ... so the
       default model binder fills List<QCUCRAM_MemberInput> directly, and
       Scripts/QCU-CRAM_reserve.js adds / removes rows and renumbers them
       without a round trip.

       The date is pinned to the booking day because
       QCUCRAM_ReservationRepository.ValidateAndCreate accepts no other date.
       ===================================================================== */

    ViewBag.Title = "Reserve a Room";

    // btnSubmit_Click() rendered "<strong>Please fix the following:</strong>" above the list.
    ViewBag.QCUCRAM_ValidationTitle = "Please fix the following:";

    var bookingDayText = Model.BookingDay.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    var memberRows = Model.Members != null && Model.Members.Count > 0
        ? Model.Members
        : new System.Collections.Generic.List<BSIT3D_GUADES_Project_MVC.QCUCRAM_Data.QCUCRAM_MemberInput>();

    var rowCount = memberRows.Count < Model.MinMembers ? Model.MinMembers : memberRows.Count;

    // ShowRequester() rendered "Last, First MI".
    var requesterName = Model.Requester == null
        ? ""
        : Model.Requester.LastName + ", " + Model.Requester.FirstName +
          (string.IsNullOrWhiteSpace(Model.Requester.MI) ? "" : " " + Model.Requester.MI);

    // ShowRestrictionBanner(): "until further notice" or "MMM d, yyyy h:mm tt".
    var restrictionUntil = !Model.RestrictionLiftDate.HasValue
        ? "further notice"
        : Model.RestrictionLiftDate.Value.ToString("MMM d, yyyy h:mm tt", CultureInfo.InvariantCulture);
}

<div class="qcu-page-head">
    <h2>Reserve a Room</h2>
    <p>Book a collaboration room for your group</p>
</div>

@Html.Partial("_QCU-CRAM_ValidationSummary")

@* ---- Restriction banner (pnlRestricted / litRestricted) ---- *@
@if (Model.IsRestricted)
{
    <div class="alert alert-danger">
        <strong>You are restricted from booking until @restrictionUntil.</strong>
        Reason: @Model.NoShowCount forfeited reservation@(Model.NoShowCount == 1 ? "" : "s").
    </div>
}

@* ---- Library rules ---- *@
<div class="card qcu-rules mb-3">
    <div class="card-body">
        <h5 class="card-title">Library rules</h5>
        @Html.Raw(Model.RulesHtml ?? string.Empty)
    </div>
</div>

@using (Html.BeginForm("Reserve", "Student", FormMethod.Post,
                      new { @class = "qcu-steps", id = "qcuReserveForm", novalidate = "novalidate" }))
{
    @Html.AntiForgeryToken()

    @* pnlForm was shown even when restricted, with Enabled = false. *@
    <fieldset @(Model.IsRestricted ? "disabled" : null) class="border-0 p-0 m-0">

        <h5 class="qcu-section">Requester</h5>
        <div class="qcu-soft">
            <dl class="row mb-0">
                <dt class="col-sm-3">Name</dt>
                <dd class="col-sm-9">@requesterName</dd>
                <dt class="col-sm-3">ID / Student number</dt>
                <dd class="col-sm-9">@(Model.Requester == null ? "" : Model.Requester.StudentNumber)</dd>
                <dt class="col-sm-3">Email</dt>
                <dd class="col-sm-9">@(Model.Requester == null ? "" : Model.Requester.Email)</dd>
                <dt class="col-sm-3">Program</dt>
                <dd class="col-sm-9">@(Model.Requester == null ? "" : Model.Requester.Program)</dd>
                <dt class="col-sm-3">Requester type</dt>
                <dd class="col-sm-9">@(Model.Requester == null ? "" : Model.Requester.RequesterType)</dd>
            </dl>
        </div>

        <h5 class="qcu-section mt-4">Reservation details</h5>
        <div class="row g-3 mb-3">
            <div class="col-md-4">
                <label class="form-label" for="Date">Date</label>
                <input type="date" id="Date" name="Date" class="form-control"
                       value="@bookingDayText" />
            </div>

            <div class="col-md-4">
                <label class="form-label" for="RoomId">Room</label>
                <select id="RoomId" name="RoomId" class="form-select">
                    <option value="0">-- Select a room --</option>
                    @foreach (var room in Model.Rooms)
                    {
                        <option value="@room.RoomID" selected="@(room.RoomID == Model.RoomId ? "selected" : null)">
                            @room.RoomName (@room.MinCapacity-@room.MaxCapacity persons)
                        </option>
                    }
                </select>
            </div>

            <div class="col-md-4">
                <label class="form-label" for="TimeSlotId">Time slot</label>
                <select id="TimeSlotId" name="TimeSlotId" class="form-select">
                    <option value="0">-- Select a time slot --</option>
                    @foreach (var slot in Model.TimeSlots)
                    {
                        <option value="@slot.TimeSlotID" selected="@(slot.TimeSlotID == Model.TimeSlotId ? "selected" : null)">
                            @Model.SlotLabel(slot.TimeSlotID)
                        </option>
                    }
                </select>
            </div>
        </div>

        <p class="small mb-3">
            Not sure which slot is free?
            <a href="@Url.Action("Index", "Availability", new { date = bookingDayText })">View the availability grid</a>.
        </p>

        <div class="mb-3">
            <label class="form-label" for="Purpose">Purpose</label>
            <textarea id="Purpose" name="Purpose" rows="3" maxlength="@Model.MaxPurposeLength"
                      class="form-control">@Model.Purpose</textarea>
            <div class="form-text">Maximum @Model.MaxPurposeLength characters.</div>
        </div>

        <h5 class="qcu-section mt-4">Group members</h5>

        <div class="mb-3" style="max-width:260px;">
            <label class="form-label" for="NumberOfMembers">Number of members (including you)</label>
            <select id="NumberOfMembers" name="NumberOfMembers" class="form-select"
                    data-qcu-members="qcuMemberBody">
                @for (var n = Model.MinMembers; n <= Model.MaxMembers; n++)
                {
                    <option value="@n" selected="@(n == Model.NumberOfMembers ? "selected" : null)">@n</option>
                }
            </select>
        </div>

        <div class="table-responsive">
            <table class="table table-sm table-bordered align-middle">
                <thead class="table-light">
                    <tr>
                        <th scope="col" style="width:50px;">#</th>
                        <th scope="col">Last name</th>
                        <th scope="col">First name</th>
                        <th scope="col" style="width:110px;">M.I.</th>
                    </tr>
                </thead>
                <tbody id="qcuMemberBody">
                    @for (var i = 0; i < rowCount; i++)
                    {
                        var member = i < memberRows.Count ? memberRows[i] : null;

                        <tr class="qcu-member-row">
                            <td class="qcu-member-num">@(i + 1)</td>
                            <td>
                                <input type="text" class="form-control" maxlength="60"
                                       name="Members[@i].LastName"
                                       value="@(member == null ? "" : member.LastName)"
                                       aria-label="Member @(i + 1) last name" />
                            </td>
                            <td>
                                <input type="text" class="form-control" maxlength="60"
                                       name="Members[@i].FirstName"
                                       value="@(member == null ? "" : member.FirstName)"
                                       aria-label="Member @(i + 1) first name" />
                            </td>
                            <td>
                                <input type="text" class="form-control" maxlength="5"
                                       name="Members[@i].MI"
                                       value="@(member == null ? "" : member.MI)"
                                       aria-label="Member @(i + 1) middle initial" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <button type="submit" class="btn btn-cta btn-lg">Submit Request</button>
        @* btnReset_Click did Response.Redirect back to a clean Reserve page. *@
        <a href="@Url.Action("Reserve", "Student")" class="btn btn-outline-secondary btn-lg">Reset form</a>
    </fieldset>
}

@section scripts {
    @Scripts.Render("~/bundles/QCU-CRAM_reserve")
}
