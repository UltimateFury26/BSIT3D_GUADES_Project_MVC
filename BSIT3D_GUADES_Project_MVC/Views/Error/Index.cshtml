@{
    /* =====================================================================
       QCU-CRAM  |  Views/Error/Index.cshtml
       ---------------------------------------------------------------------
       The page ErrorController returns for an unhandled exception (500) and
       for a missing page (404). Web.config points customErrors at ~/error.

       FIX (Phase 09 audit): this file used to set
           Layout = "~/Views/Shared/_Layout.cshtml"
       which was the Visual Studio scaffold layout - a plain Bootstrap page
       with none of the QCU-CRAM header, navigation or footer. That was one of
       the visible "the MVC design does not match the original" differences.
       It now uses the real site layout, so the error page looks like every
       other screen.

       Never show the exception text here - only the reference id.
       ===================================================================== */

    Layout = "~/Views/Shared/_QCU-CRAM_Layout.cshtml";
    ViewBag.Title = "Something went wrong";

    string reference = Convert.ToString(ViewBag.QCUCRAM_ErrorReference ?? string.Empty);
}

<div class="qcu-page-head">
    <div>
        <h1 class="qcu-page-title">Something went wrong</h1>
        <p class="qcu-page-sub">The page could not be completed.</p>
    </div>
</div>

<section class="qcu-panel">
    <div class="qcu-panel__body">
        <p class="qcu-muted">
            The problem has been written to the application log so it can be looked at.
            Please try again. If it keeps happening, contact
            <a href="mailto:cram@qcu.edu.ph">cram@qcu.edu.ph</a> and quote the reference below.
        </p>

        @if (!string.IsNullOrEmpty(reference))
        {
            <p class="qcu-muted qcu-small">
                Reference: <code>@reference</code>
            </p>
        }

        <div class="qcu-btn-row">
            <a class="qcu-btn qcu-btn--primary" href="@Url.Action("Index", "Home")">Back to home</a>
            <a class="qcu-btn qcu-btn--ghost" href="@Url.Action("Login", "Account")">Sign in again</a>
        </div>
    </div>
</section>
