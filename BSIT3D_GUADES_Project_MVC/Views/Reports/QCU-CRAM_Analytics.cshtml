@model BSIT3D_GUADES_Project_MVC.QCUCRAM_ViewModels.QCUCRAMAnalyticsViewModel
@using System
@using System.Globalization
@using System.Linq
@{
    /* =====================================================================
       QCU-CRAM  |  Views/Reports/QCU-CRAM_Analytics.cshtml
       ---------------------------------------------------------------------
       One-to-one port of Guades_QCUCram_Reports/Guades_QCUCram_Analytics.aspx.

       Same markup and classes as the .aspx, in the same order:
         page head                  qcu-page-head  h2 + p
         date filter                qcu-toolbar mb-3 > row g-3 (From, To, buttons)
         "Showing reservations..."  p.qcu-range
         summary cards              qcu-stat qcu-stat-<colour>  (4 + 3)
         cards                      Status, Month, Weekday, Peak slots (col-lg-6),
                                    Room utilization (col-12), Program, Decisions,
                                    No-shows per student, Top repeat bookers (col-lg-6)

       The five-bar-column tables come from _QCU-CRAM_BarTable.cshtml. Room
       utilization has its own columns in the original (Booked / Available /
       Utilization % + bar), so it is written out here.

       Original range errors (lblMessage -> toast) are flashed by the controller.
       ===================================================================== */

    ViewBag.Title = "Analytics";

    CultureInfo inv = CultureInfo.InvariantCulture;
    string dash = "\u2014";
}

<div class="qcu-page-head">
    <h2>Analytics</h2>
    <p>Booking trends, room utilization and no-show statistics</p>
</div>

@* ================= Date range filter ================= *@
<form method="get" action="@Url.Action("Analytics", "Reports")" class="qcu-toolbar mb-3">
    <div class="row g-3 align-items-end">
        <div class="col-md-3">
            <label for="txtFrom" class="form-label">From date</label>
            <input type="date" id="txtFrom" name="from" class="form-control" data-live-btn="btnApply"
                   value="@Model.From.ToString("yyyy-MM-dd", inv)" />
        </div>
        <div class="col-md-3">
            <label for="txtTo" class="form-label">To date</label>
            <input type="date" id="txtTo" name="to" class="form-control" data-live-btn="btnApply"
                   value="@Model.To.ToString("yyyy-MM-dd", inv)" />
        </div>
        <div class="col-md-6">
            <button type="submit" id="btnApply" class="btn btn-primary me-2">Apply</button>
            <a id="btnLast30" class="btn btn-outline-secondary me-1" href="@Url.Action("Analytics", "Reports", new { range = "last30" })">Last 30 days</a>
            <a id="btnThisMonth" class="btn btn-outline-secondary me-1" href="@Url.Action("Analytics", "Reports", new { range = "month" })">This month</a>
            <a id="btnAllTime" class="btn btn-outline-secondary" href="@Url.Action("Analytics", "Reports", new { range = "all" })">All time</a>
        </div>
    </div>
</form>

@if (Model.HasResults)
{
    <p class="qcu-range">Showing reservations dated <strong>@Model.RangeText</strong></p>

    @* ================= Summary cards ================= *@
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="card card-body qcu-stat qcu-stat-blue h-100">
                <div class="stat-label">Total bookings</div>
                <div class="stat-value">@Model.TotalBookings.ToString("N0", inv)</div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card card-body qcu-stat qcu-stat-orange h-100">
                <div class="stat-label">No-show rate</div>
                <div class="stat-value">@(Model.NoShowPct.HasValue ? Model.NoShowPct.Value.ToString("0.0", inv) + "%" : dash)</div>
                <div class="stat-note">@Model.Forfeited.ToString(inv) forfeited of @Model.ApprovedOrLater.ToString(inv) approved or later</div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card card-body qcu-stat qcu-stat-red h-100">
                <div class="stat-label">Currently restricted</div>
                <div class="stat-value">@Model.CurrentlyRestricted.ToString("N0", inv)</div>
                <div class="stat-note">Right now (not affected by the date range)</div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card card-body qcu-stat qcu-stat-green h-100">
                <div class="stat-label">Average group size</div>
                <div class="stat-value">@(Model.AverageGroupSize.HasValue ? Model.AverageGroupSize.Value.ToString("0.0", inv) : dash)</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card card-body qcu-stat qcu-stat-blue h-100">
                <div class="stat-label">Most booked room</div>
                <div class="stat-value">@Model.MostRoom</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card card-body qcu-stat qcu-stat-grey h-100">
                <div class="stat-label">Least booked room</div>
                <div class="stat-value">@Model.LeastRoom</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card card-body qcu-stat qcu-stat-orange h-100">
                <div class="stat-label">Peak time slot</div>
                <div class="stat-value">@Model.PeakSlot</div>
            </div>
        </div>
    </div>

    @* ================= Visual analytics ================= *@
    <div class="row g-3 qcu-report-charts">
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header">Status breakdown</div>
                <div class="card-body chart-card-body"><div class="chart-wrap chart-wrap-doughnut"><canvas id="statusChart" role="img" aria-label="Doughnut chart showing booking totals by status"></canvas></div></div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header">Bookings per month</div>
                <div class="card-body chart-card-body"><div class="chart-wrap"><canvas id="monthChart" role="img" aria-label="Line chart showing bookings per month"></canvas></div></div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header">Bookings per weekday</div>
                <div class="card-body chart-card-body"><div class="chart-wrap"><canvas id="weekdayChart" role="img" aria-label="Column chart showing bookings per weekday"></canvas></div></div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header">Peak time slots (booked or forfeited)</div>
                <div class="card-body chart-card-body"><div class="chart-wrap"><canvas id="timeChart" role="img" aria-label="Column chart showing demand by time slot"></canvas></div></div>
            </div>
        </div>
        <div class="col-12">
            <div class="card">
                <div class="card-header">Room utilization (confirmed bookings vs. available slots)</div>
                <div class="card-body"><div class="chart-wrap chart-wrap-room"><canvas id="roomChart" role="img" aria-label="Horizontal bar chart showing room utilization percentages"></canvas></div></div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header">Bookings per program</div>
                <div class="card-body chart-card-body"><div class="chart-wrap chart-wrap-doughnut"><canvas id="programChart" role="img" aria-label="Doughnut chart showing bookings by program"></canvas></div></div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header">Library assistant decisions</div>
                <div class="card-body chart-card-body"><div class="chart-wrap chart-wrap-doughnut"><canvas id="decisionChart" role="img" aria-label="Pie chart showing library assistant decisions"></canvas></div></div>
            </div>
        </div>

        @* ================= Plain tables ================= *@
        <div class="col-lg-6">
            <div class="card mb-3">
                <div class="card-header">No-shows per student</div>
                <div class="card-body p-2">
                    <div class="table-responsive">
                        <table class="table table-sm table-bordered table-striped mb-0">
                            @if (Model.NoShowsPerStudent == null || Model.NoShowsPerStudent.Count == 0)
                            {
                                <tbody><tr><td>No forfeited reservations in this range.</td></tr></tbody>
                            }
                            else
                            {
                                <thead>
                                    <tr>
                                        <th scope="col">ID / Student No.</th>
                                        <th scope="col">Name</th>
                                        <th scope="col" style="width:100px;">Forfeitures</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in Model.NoShowsPerStudent)
                                    {
                                        <tr>
                                            <td>@row.StudentNumber</td>
                                            <td>@row.Student</td>
                                            <td style="width:100px;">@row.Forfeitures.ToString(inv)</td>
                                        </tr>
                                    }
                                </tbody>
                            }
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card mb-3">
                <div class="card-header">Top repeat bookers (top 10)</div>
                <div class="card-body p-2">
                    <div class="table-responsive">
                        <table class="table table-sm table-bordered table-striped mb-0">
                            @if (Model.TopRepeatBookers == null || Model.TopRepeatBookers.Count == 0)
                            {
                                <tbody><tr><td>No reservations in this range.</td></tr></tbody>
                            }
                            else
                            {
                                <thead>
                                    <tr>
                                        <th scope="col">ID / Student No.</th>
                                        <th scope="col">Name</th>
                                        <th scope="col" style="width:100px;">Bookings</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in Model.TopRepeatBookers)
                                    {
                                        <tr>
                                            <td>@row.StudentNumber</td>
                                            <td>@row.FullName</td>
                                            <td style="width:100px;">@row.Total.ToString(inv)</td>
                                        </tr>
                                    }
                                </tbody>
                            }
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@section scripts {
    <style>
        .qcu-report-charts .card { min-width: 0; }
        .qcu-report-charts .card-header { font-weight: 600; }
        .chart-card-body { padding: 1rem; }
        .chart-wrap { position: relative; width: 100%; height: 290px; }
        .chart-wrap-doughnut { height: 310px; }
        .chart-wrap-room { height: 330px; }
        .chart-wrap canvas { max-width: 100%; }
        @@media (max-width: 575.98px) {
            .chart-wrap, .chart-wrap-doughnut { height: 260px; }
            .chart-wrap-room { height: 300px; }
        }
    </style>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
    <script>
        (function () {
            if (typeof Chart === "undefined") return;

            var palette = ["#155da8", "#397fbd", "#69a3d4", "#f0a34a", "#e16b5a", "#6c8c78", "#8b79b5", "#9aa7b5", "#d0a34b", "#4c9b9b"];
            var gridColor = "rgba(25, 55, 85, .10)";
            var axisFont = { family: "inherit", size: 12 };
            var numberFormat = function (value) { return Number(value).toLocaleString(); };

            function source(table) {
                var rows = table && table.Rows ? table.Rows : [];
                return {
                    labels: rows.map(function (r) { return r.Label || "Not specified"; }),
                    values: rows.map(function (r) { return Number(r.Total) || 0; })
                };
            }
            function makeChart(id, type, data, options) {
                var canvas = document.getElementById(id);
                if (!canvas || !data.labels.length) {
                    if (canvas) {
                        var message = document.createElement("p");
                        message.className = "text-muted text-center mb-0";
                        message.textContent = "No data available for this period.";
                        canvas.parentNode.replaceChild(message, canvas);
                    }
                    return;
                }
                var defaults = {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: type === "doughnut" || type === "pie", position: "bottom", labels: { usePointStyle: true, padding: 16, font: axisFont } },
                        tooltip: { callbacks: { label: function (ctx) { return " " + ctx.label + ": " + numberFormat(ctx.parsed.y !== undefined ? ctx.parsed.y : ctx.parsed) + " bookings"; } } }
                    },
                    scales: type === "doughnut" || type === "pie" ? {} : {
                        x: { grid: { display: false }, ticks: { font: axisFont } },
                        y: { beginAtZero: true, grid: { color: gridColor }, ticks: { precision: 0, font: axisFont } }
                    }
                };
                new Chart(canvas, { type: type, data: data, options: Object.assign(defaults, options || {}) });
            }
            function pieData(table) {
                var d = source(table);
                return { labels: d.labels, datasets: [{ data: d.values, backgroundColor: palette, borderColor: "#fff", borderWidth: 2, hoverOffset: 7 }] };
            }
            function barData(table, horizontal) {
                var d = source(table);
                return {
                    labels: d.labels,
                    datasets: [{ label: "Bookings", data: d.values, backgroundColor: horizontal ? "#286eaf" : "#397fbd", borderRadius: 6, maxBarThickness: 34 }]
                };
            }

            var status = @Html.Raw(Json.Encode(Model.StatusBreakdown));
            var months = @Html.Raw(Json.Encode(Model.BookingsPerMonth));
            var weekdays = @Html.Raw(Json.Encode(Model.BookingsPerWeekday));
            var times = @Html.Raw(Json.Encode(Model.PeakTimeSlots));
            var programs = @Html.Raw(Json.Encode(Model.BookingsPerProgram));
            var decisions = @Html.Raw(Json.Encode(Model.AdminDecisions));

            makeChart("statusChart", "doughnut", pieData(status), { cutout: "58%" });
            var monthSource = source(months);
            makeChart("monthChart", "line", {
                labels: monthSource.labels,
                datasets: [{ label: "Bookings", data: monthSource.values, borderColor: "#155da8", backgroundColor: "rgba(21,93,168,.14)", fill: true, tension: .32, pointRadius: 4, pointHoverRadius: 6 }]
            });
            makeChart("weekdayChart", "bar", barData(weekdays, false));
            makeChart("timeChart", "bar", barData(times, false));
            makeChart("programChart", "doughnut", pieData(programs), { cutout: "54%" });
            makeChart("decisionChart", "pie", pieData(decisions));

            var roomRows = @Html.Raw(Json.Encode((Model.RoomRows ?? new System.Collections.Generic.List<BSIT3D_GUADES_Project_MVC.QCUCRAM_Data.QCUCRAM_RoomUtilizationRow>()).Select(r => new { label = r.RoomName, booked = r.Booked, available = r.Available, utilization = r.UtilizationPct })));
            var roomCanvas = document.getElementById("roomChart");
            if (roomCanvas && roomRows.length) {
                new Chart(roomCanvas, {
                    type: "bar",
                    data: {
                        labels: roomRows.map(function (r) { return r.label; }),
                        datasets: [{ label: "Utilization", data: roomRows.map(function (r) { return Number(r.utilization) || 0; }), backgroundColor: "#286eaf", borderRadius: 6, maxBarThickness: 30 }]
                    },
                    options: {
                        indexAxis: "y", responsive: true, maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false },
                            tooltip: { callbacks: { label: function (ctx) {
                                var r = roomRows[ctx.dataIndex];
                                return " " + (Number(r.utilization) || 0).toFixed(1) + "% (" + numberFormat(r.booked) + " booked / " + numberFormat(r.available) + " available)";
                            } } }
                        },
                        scales: {
                            x: { beginAtZero: true, max: 100, grid: { color: gridColor }, ticks: { callback: function (v) { return v + "%"; }, font: axisFont } },
                            y: { grid: { display: false }, ticks: { font: axisFont } }
                        }
                    }
                });
            } else if (roomCanvas) {
                var empty = document.createElement("p");
                empty.className = "text-muted text-center mb-0";
                empty.textContent = "No room utilization data available for this period.";
                roomCanvas.parentNode.replaceChild(empty, roomCanvas);
            }
        })();
    </script>
}
