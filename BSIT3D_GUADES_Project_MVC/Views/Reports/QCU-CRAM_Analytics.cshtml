@model BSIT3D_GUADES_Project_MVC.QCUCRAM_ViewModels.QCUCRAMAnalyticsViewModel
@using System
@using System.Globalization
@{
    /* =====================================================================
       QCU-CRAM  |  Views/Reports/QCU-CRAM_Analytics.cshtml
       ---------------------------------------------------------------------
       One-to-one port of Guades_QCUCram_Reports/Guades_QCUCram_Analytics.aspx.

       Same markup and classes as the .aspx, in the same order:
         page head                  qcu-page-head  h2 + p
         date filter                qcu-toolbar mb-3 > row g-3 (From, To, buttons)
         "Showing reservations..."  p.qcu-range
         summary cards              qcu-stat qcu-stat-<colour>  (4 + 3)
         cards                      Status, Month, Weekday, Peak slots (col-lg-6),
                                    Room utilization (col-12), Program, Decisions,
                                    No-shows per student, Top repeat bookers (col-lg-6)

       The five-bar-column tables come from _QCU-CRAM_BarTable.cshtml. Room
       utilization has its own columns in the original (Booked / Available /
       Utilization % + bar), so it is written out here.

       Original range errors (lblMessage -> toast) are flashed by the controller.
       ===================================================================== */

    ViewBag.Title = "Analytics";

    CultureInfo inv = CultureInfo.InvariantCulture;
    string dash = "\u2014";
}

<div class="qcu-page-head">
    <h2>Analytics</h2>
    <p>Booking trends, room utilization and no-show statistics</p>
</div>

@* ================= Date range filter ================= *@
<form method="get" action="@Url.Action("Analytics", "Reports")" class="qcu-toolbar mb-3">
    <div class="row g-3 align-items-end">
        <div class="col-md-3">
            <label for="txtFrom" class="form-label">From date</label>
            <input type="date" id="txtFrom" name="from" class="form-control" data-live-btn="btnApply"
                   value="@Model.From.ToString("yyyy-MM-dd", inv)" />
        </div>
        <div class="col-md-3">
            <label for="txtTo" class="form-label">To date</label>
            <input type="date" id="txtTo" name="to" class="form-control" data-live-btn="btnApply"
                   value="@Model.To.ToString("yyyy-MM-dd", inv)" />
        </div>
        <div class="col-md-6">
            <button type="submit" id="btnApply" class="btn btn-primary me-2">Apply</button>
            <a id="btnLast30" class="btn btn-outline-secondary me-1" href="@Url.Action("Analytics", "Reports", new { range = "last30" })">Last 30 days</a>
            <a id="btnThisMonth" class="btn btn-outline-secondary me-1" href="@Url.Action("Analytics", "Reports", new { range = "month" })">This month</a>
            <a id="btnAllTime" class="btn btn-outline-secondary" href="@Url.Action("Analytics", "Reports", new { range = "all" })">All time</a>
        </div>
    </div>
</form>

@if (Model.HasResults)
{
    <p class="qcu-range">Showing reservations dated <strong>@Model.RangeText</strong></p>

    @* ================= Summary cards ================= *@
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="card card-body qcu-stat qcu-stat-blue h-100">
                <div class="stat-label">Total bookings</div>
                <div class="stat-value">@Model.TotalBookings.ToString("N0", inv)</div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card card-body qcu-stat qcu-stat-orange h-100">
                <div class="stat-label">No-show rate</div>
                <div class="stat-value">@(Model.NoShowPct.HasValue ? Model.NoShowPct.Value.ToString("0.0", inv) + "%" : dash)</div>
                <div class="stat-note">@Model.Forfeited.ToString(inv) forfeited of @Model.ApprovedOrLater.ToString(inv) approved or later</div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card card-body qcu-stat qcu-stat-red h-100">
                <div class="stat-label">Currently restricted</div>
                <div class="stat-value">@Model.CurrentlyRestricted.ToString("N0", inv)</div>
                <div class="stat-note">Right now (not affected by the date range)</div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card card-body qcu-stat qcu-stat-green h-100">
                <div class="stat-label">Average group size</div>
                <div class="stat-value">@(Model.AverageGroupSize.HasValue ? Model.AverageGroupSize.Value.ToString("0.0", inv) : dash)</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card card-body qcu-stat qcu-stat-blue h-100">
                <div class="stat-label">Most booked room</div>
                <div class="stat-value">@Model.MostRoom</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card card-body qcu-stat qcu-stat-grey h-100">
                <div class="stat-label">Least booked room</div>
                <div class="stat-value">@Model.LeastRoom</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card card-body qcu-stat qcu-stat-orange h-100">
                <div class="stat-label">Peak time slot</div>
                <div class="stat-value">@Model.PeakSlot</div>
            </div>
        </div>
    </div>

    @* ================= Tables with bars ================= *@
    <div class="row">
        <div class="col-lg-6">@Html.Partial("_QCU-CRAM_BarTable", Model.StatusBreakdown)</div>
        <div class="col-lg-6">@Html.Partial("_QCU-CRAM_BarTable", Model.BookingsPerMonth)</div>
        <div class="col-lg-6">@Html.Partial("_QCU-CRAM_BarTable", Model.BookingsPerWeekday)</div>
        <div class="col-lg-6">@Html.Partial("_QCU-CRAM_BarTable", Model.PeakTimeSlots)</div>

        <div class="col-12">
            <div class="card mb-3">
                <div class="card-header">Room utilization (confirmed bookings vs. available slots)</div>
                <div class="card-body p-2">
                    <div class="table-responsive">
                        <table class="table table-sm table-bordered align-middle mb-0">
                            @if (Model.RoomRows == null || Model.RoomRows.Count == 0)
                            {
                                <tbody><tr><td>No rooms found.</td></tr></tbody>
                            }
                            else
                            {
                                <thead>
                                    <tr>
                                        <th scope="col">Room</th>
                                        <th scope="col" style="width:80px;">Booked</th>
                                        <th scope="col" style="width:90px;">Available</th>
                                        <th scope="col" style="width:110px;">Utilization %</th>
                                        <th scope="col"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var room in Model.RoomRows)
                                    {
                                        double util = room.UtilizationPct.HasValue ? (double)room.UtilizationPct.Value : 0.0;
                                        double pct = Math.Min(100.0, util);
                                        <tr>
                                            <td>@room.RoomName</td>
                                            <td style="width:80px;">@room.Booked.ToString(inv)</td>
                                            <td style="width:90px;">@room.Available.ToString(inv)</td>
                                            <td style="width:110px;">@(room.UtilizationPct.HasValue ? room.UtilizationPct.Value.ToString("0.0", inv) + "%" : dash)</td>
                                            <td><div class="bar-track"><div class="bar-fill" style="width:@(pct.ToString("0.#", inv))%"></div></div></td>
                                        </tr>
                                    }
                                </tbody>
                            }
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-6">@Html.Partial("_QCU-CRAM_BarTable", Model.BookingsPerProgram)</div>
        <div class="col-lg-6">@Html.Partial("_QCU-CRAM_BarTable", Model.AdminDecisions)</div>

        @* ================= Plain tables ================= *@
        <div class="col-lg-6">
            <div class="card mb-3">
                <div class="card-header">No-shows per student</div>
                <div class="card-body p-2">
                    <div class="table-responsive">
                        <table class="table table-sm table-bordered table-striped mb-0">
                            @if (Model.NoShowsPerStudent == null || Model.NoShowsPerStudent.Count == 0)
                            {
                                <tbody><tr><td>No forfeited reservations in this range.</td></tr></tbody>
                            }
                            else
                            {
                                <thead>
                                    <tr>
                                        <th scope="col">ID / Student No.</th>
                                        <th scope="col">Name</th>
                                        <th scope="col" style="width:100px;">Forfeitures</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in Model.NoShowsPerStudent)
                                    {
                                        <tr>
                                            <td>@row.StudentNumber</td>
                                            <td>@row.Student</td>
                                            <td style="width:100px;">@row.Forfeitures.ToString(inv)</td>
                                        </tr>
                                    }
                                </tbody>
                            }
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card mb-3">
                <div class="card-header">Top repeat bookers (top 10)</div>
                <div class="card-body p-2">
                    <div class="table-responsive">
                        <table class="table table-sm table-bordered table-striped mb-0">
                            @if (Model.TopRepeatBookers == null || Model.TopRepeatBookers.Count == 0)
                            {
                                <tbody><tr><td>No reservations in this range.</td></tr></tbody>
                            }
                            else
                            {
                                <thead>
                                    <tr>
                                        <th scope="col">ID / Student No.</th>
                                        <th scope="col">Name</th>
                                        <th scope="col" style="width:100px;">Bookings</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in Model.TopRepeatBookers)
                                    {
                                        <tr>
                                            <td>@row.StudentNumber</td>
                                            <td>@row.FullName</td>
                                            <td style="width:100px;">@row.Total.ToString(inv)</td>
                                        </tr>
                                    }
                                </tbody>
                            }
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
