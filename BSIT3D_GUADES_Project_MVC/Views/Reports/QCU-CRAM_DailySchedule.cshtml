@model BSIT3D_GUADES_Project_MVC.QCUCRAM_ViewModels.QCUCRAMDailyScheduleViewModel
@using System
@using System.Globalization
@{
    /* =====================================================================
       QCU-CRAM  |  Views/Reports/QCU-CRAM_DailySchedule.cshtml
       ---------------------------------------------------------------------
       Port of Guades_QCUCram_Admin/Guades_QCUCram_DailySchedule.aspx.

       The Web Forms page had five postback buttons (previous, next, today,
       tomorrow, show). Here every one of them is a plain link carrying
       ?date=yyyy-MM-dd, so each day is a real, bookmarkable URL and the
       browser's Back button behaves.

       On paper this is a landscape sheet: letterhead, day title, the booking
       table and a signature line. The toolbar, the page heading and the
       pending note are all .qcu-no-print.
       ===================================================================== */

    ViewBag.Title = "Daily Schedule";

    CultureInfo inv = CultureInfo.InvariantCulture;

    Func<DateTime, string> day = d => d.ToString("yyyy-MM-dd", inv);
    DateTime today = BSIT3D_GUADES_Project_MVC.QCUCRAM_Helpers.QCUCRAM_Clock.Today;
}

@section head {
    <style>
        @@media print {
            @@page { size: A4 landscape; margin: 12mm; }
        }
    </style>
}

<div class="qcu-page-head qcu-no-print">
    <div>
        <h1 class="qcu-page-title">Daily Schedule</h1>
        <p class="qcu-page-sub">Confirmed bookings for the day, ready to print for the front desk</p>
    </div>
</div>

<form method="get" action="@Url.Action("DailySchedule", "Reports")" class="qcu-toolbar qcu-no-print">
    <label>
        Date
        <input type="date" name="date" class="qcu-input" value="@day(Model.Date)" />
    </label>
    <button type="submit" class="qcu-btn qcu-btn--primary">Show</button>

    <span class="qcu-btn-row">
        <a class="qcu-btn qcu-btn--ghost"
           href="@Url.Action("DailySchedule", "Reports", new { date = day(Model.PreviousDay) })">&laquo; Previous day</a>
        <a class="qcu-btn qcu-btn--ghost"
           href="@Url.Action("DailySchedule", "Reports", new { date = day(Model.NextDay) })">Next day &raquo;</a>
        <a class="qcu-btn qcu-btn--ghost"
           href="@Url.Action("DailySchedule", "Reports", new { date = day(today) })">Today</a>
        <a class="qcu-btn qcu-btn--ghost"
           href="@Url.Action("DailySchedule", "Reports", new { date = day(today.AddDays(1)) })">Tomorrow</a>
        <button type="button" class="qcu-btn qcu-btn--primary" onclick="window.print();">Print</button>
    </span>
</form>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="qcu-alert qcu-alert--error">@Model.ErrorMessage</div>
}

@if (string.IsNullOrEmpty(Model.ErrorMessage))
{
<div class="qcu-print-header qcu-print-only">
    <img src="@Url.Content("~/Content/images/QCU-CRAM_qcu-logo.png")" alt="Quezon City University" />
    <div>
        <div class="qcu-print-title">Quezon City University</div>
        <div class="qcu-print-subtitle">QCU Library &mdash; Collaboration Room Reservation</div>
        <div class="qcu-print-subtitle"><strong>Daily Room Schedule</strong></div>
    </div>
</div>

<h2 class="qcu-day-title">@Model.DateTitle</h2>

<p class="qcu-muted">
    @Model.ConfirmedCount confirmed booking(s).
    @if (Model.PendingCount > 0)
    {
        <span class="qcu-no-print">@Model.PendingCount pending request(s) for this date are not listed.</span>
    }
</p>

<div class="qcu-table-wrap">
    <table class="qcu-table qcu-table--print">
        <thead>
            <tr>
                <th>Time</th>
                <th>Room</th>
                <th>Requester</th>
                <th>Program</th>
                <th class="qcu-num">Members</th>
                <th>Purpose</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Rows == null || Model.Rows.Count == 0)
            {
                <tr>
                    <td colspan="7" class="qcu-empty">No confirmed bookings for this date.</td>
                </tr>
            }
            else
            {
                foreach (var row in Model.Rows)
                {
                    <tr>
                        <td class="qcu-nowrap">@row.TimeText</td>
                        <td>@row.RoomName</td>
                        <td>
                            <strong>@row.RequesterName</strong><br />
                            <small>@row.StudentNumber | @row.RequesterType</small>
                        </td>
                        <td>@row.Program</td>
                        <td class="qcu-num">@row.NumberOfMembers.ToString("N0", inv)</td>
                        <td>@row.Purpose</td>
                        <td>@Html.Partial("_QCU-CRAM_StatusBadge", row.Status)</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<div class="qcu-print-signature qcu-print-only">
    <div>Library Assistant</div>
</div>

<p class="qcu-muted qcu-small qcu-print-only">
    Printed @Model.PrintedAt.ToString("MMM d, yyyy h:mm tt", inv) by @Model.PrintedBy
</p>
}
