@model BSIT3D_GUADES_Project_MVC.QCUCRAM_ViewModels.QCUCRAMBarTable
@using System
@using System.Globalization
@{
    /* =====================================================================
       QCU-CRAM  |  Views/Reports/_QCU-CRAM_BarTable.cshtml
       ---------------------------------------------------------------------
       One bar-table card from Guades_QCUCram_Analytics.aspx: the GridView
       (label | Total 70px | bar) inside  card > card-header + card-body p-2 >
       table-responsive. The caller supplies the col-lg-6 wrapper.

       The bar markup is what gvBar_RowDataBound wrote:
           <div class="bar-track"><div class="bar-fill" style="width:N%"></div></div>

       InvariantCulture is mandatory: a comma decimal separator makes
       style="width:42,9%" invalid and every bar renders empty.

       An empty list shows the GridView's EmptyDataText in a one-cell table.
       ===================================================================== */

    CultureInfo inv = CultureInfo.InvariantCulture;
}

<div class="card mb-3">
    <div class="card-header">@Model.Title</div>
    <div class="card-body p-2">
        <div class="table-responsive">
            <table class="table table-sm table-bordered align-middle mb-0">
                @if (Model.Rows == null || Model.Rows.Count == 0)
                {
                    <tbody><tr><td>@Model.EmptyText</td></tr></tbody>
                }
                else
                {
                    <thead>
                        <tr>
                            <th scope="col">@Model.LabelHeader</th>
                            <th scope="col" style="width:70px;">@Model.ValueHeader</th>
                            <th scope="col">@Model.BarHeader</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Rows)
                        {
                            <tr>
                                <td>@row.Label</td>
                                <td style="width:70px;">@row.Total.ToString(inv)</td>
                                <td><div class="bar-track"><div class="bar-fill" style="width:@(row.Pct.ToString("0.#", inv))%"></div></div></td>
                            </tr>
                        }
                    </tbody>
                }
            </table>
        </div>
    </div>
</div>
