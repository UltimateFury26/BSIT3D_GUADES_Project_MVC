@model BSIT3D_GUADES_Project_MVC.QCUCRAM_ViewModels.QCUCRAMPrintBookingViewModel
@using System
@using System.Globalization
@{
    /* =====================================================================
       QCU-CRAM  |  Views/Reports/QCU-CRAM_PrintBooking.cshtml
       ---------------------------------------------------------------------
       Port of Guades_QCUCram_Reports/Guades_QCUCram_PrintBooking.aspx(.cs).

       The markup is the same HTML the Web Forms BuildReport() produced:
       div.report > div.report-header, h5 + table.kv / table.grid, sign-row.
       Scripts/QCU-CRAM_ui.js (the "Print" pop-up on My Reservations and
       Records) looks for the .report element in this page's HTML, so the
       class names must not change.
       ===================================================================== */

    ViewBag.Title = "Booking Report";

    CultureInfo inv = CultureInfo.InvariantCulture;
    Func<string, string> statusLabel = st => st == "CheckedIn" ? "Checked In" : st;
}

<style>
    @@media print {
        @@page { margin: 14mm; }
    }
</style>

<div class="no-print mb-3">
    <button type="button" class="btn btn-success" onclick="window.print();">Print</button>
    <a class="btn btn-outline-secondary" href="@Url.Content("~" + Model.BackUrl)">Back</a>
</div>

@if (Model.Found)
{
    <div class="report">
        <div class="report-header">
            <img class="report-seal" alt="" src="@Url.Content("~/Content/images/QCU-CRAM_qcu-logo.png")" />
            <h3>Quezon City University</h3>
            <div class="sub">QCU Library &mdash; Collaboration Room Reservation</div>
            <div><strong>Reservation #@Model.ReservationId</strong> &nbsp;|&nbsp; Status: <strong>@statusLabel(Model.Status)</strong></div>
        </div>

        <h5>Requester</h5>
        <table class="kv">
            <tr><td class="k">Name</td><td>@Model.RequesterName</td></tr>
            <tr><td class="k">ID / Student Number</td><td>@Model.StudentNumber</td></tr>
            <tr><td class="k">Requester type</td><td>@Model.RequesterType</td></tr>
            <tr><td class="k">Program</td><td>@Model.Program</td></tr>
            <tr><td class="k">Email</td><td>@Model.Email</td></tr>
        </table>

        <h5>Reservation Details</h5>
        <table class="kv">
            <tr><td class="k">Room</td><td>@Model.RoomName</td></tr>
            <tr><td class="k">Date</td><td>@Model.ReservationDate.ToString("dddd, MMMM d, yyyy", inv)</td></tr>
            <tr><td class="k">Time</td><td>@Model.TimeText</td></tr>
            <tr><td class="k">Number of members</td><td>@Model.NumberOfMembers.ToString(inv)</td></tr>
            <tr><td class="k">Purpose</td><td>@Model.Purpose</td></tr>
            <tr><td class="k">Requested on</td><td>@Model.CreatedAt.ToString("MMM d, yyyy h:mm tt", inv)</td></tr>
            <tr><td class="k">Checked in at</td><td>@(Model.CheckedInAt.HasValue ? Model.CheckedInAt.Value.ToString("MMM d, yyyy h:mm tt", inv) : "\u2014")</td></tr>
        </table>

        <h5>Group Members</h5>
        @if (Model.Members == null || Model.Members.Count == 0)
        {
            <p class="text-muted">No member names on file.</p>
        }
        else
        {
            <table class="grid">
                <thead><tr><th style="width:50px">No.</th><th>Name (Last, First MI)</th></tr></thead>
                <tbody>
                    @for (int i = 0; i < Model.Members.Count; i++)
                    {
                        <tr><td>@(i + 1)</td><td>@Model.Members[i].FullName</td></tr>
                    }
                </tbody>
            </table>
        }

        <h5>Status History</h5>
        @if (Model.History == null || Model.History.Count == 0)
        {
            <p class="text-muted">No status changes recorded.</p>
        }
        else
        {
            <table class="grid">
                <thead><tr><th>When</th><th>Change</th><th>By</th><th>Notes</th></tr></thead>
                <tbody>
                    @foreach (var h in Model.History)
                    {
                        <tr>
                            <td>@h.ChangedAt.ToString("MMM d, yyyy h:mm tt", inv)</td>
                            <td>@((string.IsNullOrEmpty(h.OldStatus) ? "New" : statusLabel(h.OldStatus)) + " \u2192 " + statusLabel(h.NewStatus))</td>
                            <td>@h.ChangedByText</td>
                            <td>@h.Notes</td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        <div class="sign-row">
            <div class="sign-box"><div class="sign-line">Library Assistant</div></div>
            <div class="sign-box"><div class="sign-line">Group Representative</div></div>
        </div>
        <p class="mt-3">QCID verified &#9744;</p>

        <p class="text-muted small mb-0">Printed on @Model.PrintedAt.ToString("MMM d, yyyy h:mm tt", inv)</p>
    </div>
}
