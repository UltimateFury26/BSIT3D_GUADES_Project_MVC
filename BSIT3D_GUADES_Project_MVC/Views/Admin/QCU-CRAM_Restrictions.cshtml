@model BSIT3D_GUADES_Project_MVC.QCUCRAM_ViewModels.QCUCRAMRestrictionsViewModel
@using System.Globalization
@{
    /* =====================================================================
       QCU-CRAM  |  Views/Admin/QCU-CRAM_Restrictions.cshtml
       ---------------------------------------------------------------------
       One-to-one port of Guades_QCUCram_Admin/Guades_QCUCram_Restrictions.aspx.

       Kept exactly as the Web Forms page had it:
         print stylesheet + print-only header and signature line
         "Restrictions" head with the "Print list" button
         lblMessage, then the litRule sentence
         gvRestricted  - Student / Strikes / Restricted until / Time remaining / Action
         lift modal    - litLiftInfo, 150-char note, Cancel + "Confirm - lift restriction"
         gvWarning     - Student / Strikes ("N of 3") / Last forfeited booking
       ===================================================================== */

    ViewBag.Title = "Restrictions";
    Layout = "~/Views/Shared/_QCU-CRAM_Layout.cshtml";

    CultureInfo inv = CultureInfo.InvariantCulture;
}

<style>
    .print-only { display: none; }

    @@media print {
        nav.navbar, footer, hr, .no-print, form > .alert { display: none !important; }
        .print-only { display: block !important; }
        body { font-size: 11pt; background: #fff; }
        .container, .body-content { max-width: 100% !important; width: 100% !important; padding: 0 !important; margin: 0 !important; }
        table tr { page-break-inside: avoid; }
        @@page { margin: 14mm; }
    }
</style>

@* Header that only appears on paper *@
<div class="print-only text-center mb-3">
    <h4 class="mb-0">QCU Library &mdash; Collaboration Room Reservation</h4>
    <div>Restricted Students List</div>
    <div class="small">Printed @Model.PrintedAtText</div>
</div>

<div class="d-flex justify-content-between align-items-start flex-wrap gap-2 no-print">
    <div class="qcu-page-head">
        <h2>Restrictions</h2>
        <p>Students barred from booking, and those one strike away</p>
    </div>
    <button type="button" class="btn btn-outline-primary" onclick="window.print();">Print list</button>
</div>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert @(Model.MessageIsError ? "alert-danger" : "alert-success")">@Model.Message</div>
}

<p class="text-muted">@Html.Raw(Model.RuleText)</p>

<h5 class="qcu-subhead">Currently restricted students</h5>
<div class="table-responsive">
    <table class="table table-bordered table-striped align-middle qcu-admin-table">
        <thead>
            <tr>
                <th>Student</th>
                <th>Strikes</th>
                <th>Restricted until</th>
                <th>Time remaining</th>
                <th class="no-print">Action</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Restricted.Count == 0)
            {
                <tr><td colspan="5" class="text-muted">No students are currently restricted.</td></tr>
            }
            else
            {
                foreach (var s in Model.Restricted)
                {
                    <tr>
                        <td>@Html.Raw(s.StudentHtml)</td>
                        <td>@s.NoShowCount</td>
                        <td>@s.UntilText</td>
                        <td>@s.RemainingText</td>
                        <td class="no-print qcu-actions-cell">
                            <div class="qcu-actions">
                                <a class="btn btn-sm btn-outline-danger"
                                   href="@Url.Action("Restrictions", "Admin", new { lift = s.StudentID })">Lift now</a>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<div class="qcu-form-overlay@(Model.LiftModalCss)">
    <form method="post" action="@Url.Action("Lift", "Admin")" class="qcu-form-modal"
          role="dialog" aria-modal="true" aria-labelledby="liftModalTitle" tabindex="-1">

        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.LiftId" />

        <div class="qcu-form-head">
            <div class="qcu-form-title" id="liftModalTitle">Lift restriction</div>
            <a class="qcu-form-close" data-qcu-close aria-label="Close"
               href="@Url.Action("Restrictions", "Admin")">&times;</a>
        </div>

        <div class="qcu-form-body">
            @Html.Raw(Model.LiftInfo ?? string.Empty)
            <div class="mb-3 mt-3">
                <label class="form-label" for="txtNote">Note for the student (optional)</label>
                <input type="text" id="txtNote" name="note" maxlength="150" class="form-control" value="" />
                <div class="form-text">Lifting resets the student's strike count to 0 and sends them a notification.</div>
            </div>
        </div>

        <div class="qcu-form-foot">
            <a class="btn btn-outline-secondary" href="@Url.Action("Restrictions", "Admin")">Cancel</a>
            <button type="submit" class="btn btn-danger"
                    onclick="return qcuConfirm(this, { tone: 'warning', title: 'Lift this restriction?', message: 'The student strike count resets to 0 and they are notified that they can book again.', confirmText: 'Lift restriction' });">
                Confirm - lift restriction
            </button>
        </div>
    </form>
</div>

<h5 class="qcu-subhead mt-5">One strike away</h5>
<p class="text-muted small">Students who are not restricted but will be after their next forfeited booking.</p>
<div class="table-responsive">
    <table class="table table-bordered table-striped align-middle qcu-admin-table">
        <thead>
            <tr>
                <th>Student</th>
                <th>Strikes</th>
                <th>Last forfeited booking</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Warnings.Count == 0)
            {
                <tr><td colspan="3" class="text-muted">Nobody is one strike away from a restriction.</td></tr>
            }
            else
            {
                foreach (var w in Model.Warnings)
                {
                    <tr>
                        <td>@Html.Raw(w.StudentHtml)</td>
                        <td>@w.StrikesText</td>
                        <td>@w.LastText</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<div class="print-only" style="margin-top:40px;">Library Assistant: ______________________________</div>
