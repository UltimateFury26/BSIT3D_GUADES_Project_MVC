@model BSIT3D_GUADES_Project_MVC.QCUCRAM_ViewModels.QCUCRAMDevToolsViewModel
@using System
@using System.Globalization
@{
    /* =====================================================================
       QCU-CRAM  |  Views/Admin/QCU-CRAM_DevTools.cshtml
       ---------------------------------------------------------------------
       Port of Guades_QCUCram_Admin/Guades_QCUCram_DevTools.aspx.

       Sections, same as the original page:
         1. the warning strip ("Testing tools only ... Reset the clock");
         2. System clock - Real time / Offset / System time, five shift
            buttons (15, 60, 1440, 10080, reset);
         3. Automatic rules - the sweep hint and "Run sweep now";
         4. Sample data - counts, "Generate 10 sample students", the ID and
            password note, the 4/3/2/1 batch note, "History to generate" and
            "Days ahead" drop-downs, "Generate sample reservations", the
            "Covers all 8 statuses" hint, and the two sample clean-up buttons;
         5. Danger zone - the "Type DELETE to confirm" gate plus the
            "I understand this cannot be undone." check.

       The whole page is hidden when QCU-CRAM_DevToolsEnabled is false in
       Web.config - the controller returns 404 in that case.
       ===================================================================== */

    ViewBag.Title = "Dev Tools";
    Layout = "~/Views/Shared/_QCU-CRAM_Layout.cshtml";

    CultureInfo inv = CultureInfo.InvariantCulture;
    string stamp = "ddd, MMM d, yyyy h:mm:ss tt";
}

<div class="qcu-page-head">
    <div>
        <h1 class="qcu-page-title">Dev Tools</h1>
        <p class="qcu-page-sub">Testing tools - not for normal use</p>
    </div>
</div>

<div class="qcu-alert qcu-alert--warning" role="alert">
    Testing tools only. Moving the clock changes how every page decides what is
    &ldquo;now&rdquo;. <strong>Reset the clock when you finish testing.</strong>
</div>

@* LastResult / LastSweepSummary already carry their own alert wrapper and
   tone (success / info / danger), exactly like lblMessage and litSweepResult. *@
@if (!string.IsNullOrWhiteSpace(Model.LastResult))
{
    @Html.Raw(Model.LastResult)
}

@if (!string.IsNullOrWhiteSpace(Model.LastSweepSummary))
{
    @Html.Raw(Model.LastSweepSummary)
}

@* -------------------------------------------------------- system clock *@
<section class="qcu-panel">
    <header class="qcu-panel__head">
        <h2>System clock</h2>
    </header>

    <div class="qcu-panel__body">
        <table class="qcu-table qcu-table--kv">
            <tbody>
                <tr>
                    <th>Real time</th>
                    <td>@Model.RealNow.ToString(stamp, inv)</td>
                </tr>
                <tr>
                    <th>Offset</th>
                    <td>@Model.OffsetMinutes minute(s)</td>
                </tr>
                <tr>
                    <th>System time (used by CRAM)</th>
                    <td><strong>@Model.SimulatedNow.ToString(stamp, inv)</strong></td>
                </tr>
            </tbody>
        </table>

        <div class="qcu-btn-row">
            <form method="post" action="@Url.Action("ShiftClock")">
                @Html.AntiForgeryToken()
                <input type="hidden" name="command" value="15" />
                <button type="submit" class="qcu-btn qcu-btn--sm">+15 minutes</button>
            </form>
            <form method="post" action="@Url.Action("ShiftClock")">
                @Html.AntiForgeryToken()
                <input type="hidden" name="command" value="60" />
                <button type="submit" class="qcu-btn qcu-btn--sm">+1 hour</button>
            </form>
            <form method="post" action="@Url.Action("ShiftClock")">
                @Html.AntiForgeryToken()
                <input type="hidden" name="command" value="1440" />
                <button type="submit" class="qcu-btn qcu-btn--sm">+1 day</button>
            </form>
            <form method="post" action="@Url.Action("ShiftClock")">
                @Html.AntiForgeryToken()
                <input type="hidden" name="command" value="10080" />
                <button type="submit" class="qcu-btn qcu-btn--sm">+1 week</button>
            </form>
            <form method="post" action="@Url.Action("ShiftClock")">
                @Html.AntiForgeryToken()
                <input type="hidden" name="command" value="reset" />
                <button type="submit" class="qcu-btn qcu-btn--sm qcu-btn--danger">Reset clock</button>
            </form>
        </div>
    </div>
</section>

@* ------------------------------------------------------ automatic rules *@
<section class="qcu-panel">
    <header class="qcu-panel__head">
        <h2>Automatic rules</h2>
    </header>

    <div class="qcu-panel__body">
        <p class="qcu-hint">
            Runs: expire unreviewed pending requests, forfeit unclaimed bookings
            (adds strikes and restrictions), complete finished sessions, and lift
            expired restrictions.
        </p>

        <form method="post" action="@Url.Action("RunSweep")">
            @Html.AntiForgeryToken()
            <button type="submit" class="qcu-btn qcu-btn--primary">Run sweep now</button>
        </form>
    </div>
</section>

@* ----------------------------------------------------------- sample data *@
<section class="qcu-panel">
    <header class="qcu-panel__head">
        <h2>Sample data</h2>
    </header>

    <div class="qcu-panel__body">
        <table class="qcu-table qcu-table--kv">
            <tbody>
                <tr>
                    <th>Students</th>
                    <td>
                        @Model.Students total &middot; @Model.SampleStudents sample
                        (@Model.SampleOneStrikeAway one strike away, @Model.SampleRestricted restricted)
                    </td>
                </tr>
                <tr>
                    <th>Reservations</th>
                    <td>@Model.Reservations total &middot; @Model.SampleReservations sample</td>
                </tr>
                <tr>
                    <th>Notifications</th>
                    <td>@Model.Notifications</td>
                </tr>
            </tbody>
        </table>

        <h3 class="qcu-subhead">Students</h3>

        <form method="post" action="@Url.Action("GenerateStudents")">
            @Html.AntiForgeryToken()
            <button type="submit" class="qcu-btn qcu-btn--sm">Generate 10 sample students</button>
        </form>

        <p class="qcu-hint">
            Each click adds 10 <strong>new</strong> students (no limit). IDs look real:
            <code>24-0153</code> (Faculty <code>FAC-0123</code>, Visitor <code>VIS-0123</code>).
            Password for all: <code>Test1234!</code>
        </p>
        <p class="qcu-hint">
            Every batch of 10: 4 clean &middot; 3 one strike away &middot; 2 restricted now &middot;
            1 expired restriction (the strike limit and restriction days come from Settings).
        </p>

        <h3 class="qcu-subhead">Reservations</h3>

        <form method="post" action="@Url.Action("GenerateReservations")" class="qcu-inline-form">
            @Html.AntiForgeryToken()
            <label for="daysBack">History to generate</label>
            <select id="daysBack" name="daysBack" class="form-control qcu-input--num">
                <option value="14">14 days</option>
                <option value="30" selected="selected">30 days</option>
                <option value="60">60 days</option>
            </select>
            <label for="daysAhead">Days ahead</label>
            <select id="daysAhead" name="daysAhead" class="form-control qcu-input--num">
                <option value="14" selected="selected">14 days</option>
                <option value="21">21 days</option>
                <option value="30">30 days</option>
            </select>
            <button type="submit" class="qcu-btn qcu-btn--sm">Generate sample reservations</button>
        </form>

        <p class="qcu-hint">
            Covers all 8 statuses, every room, past days and at least 14 days ahead.
            They follow the automatic rules, so the sweep leaves them alone (a
            <em>CheckedIn</em> one needs a slot that is running right now &mdash; use the
            clock buttons above to move into library hours).
        </p>

        <div class="qcu-btn-row">
            <form method="post" action="@Url.Action("ClearSampleReservations")"
                  onsubmit="return confirm('Every SAMPLE reservation is deleted. Your own bookings are kept.');">
                @Html.AntiForgeryToken()
                <button type="submit" class="qcu-btn qcu-btn--sm qcu-btn--danger">Clear sample reservations</button>
            </form>

            <form method="post" action="@Url.Action("DeleteSampleStudents")"
                  onsubmit="return confirm('Every SAMPLE student and everything that belongs to them is deleted.');">
                @Html.AntiForgeryToken()
                <button type="submit" class="qcu-btn qcu-btn--sm qcu-btn--danger">Delete sample students and their data</button>
            </form>
        </div>
    </div>
</section>

@* ----------------------------------------------------------- danger zone *@
<section class="qcu-panel qcu-panel--danger">
    <header class="qcu-panel__head">
        <h2>Danger zone</h2>
    </header>

    <div class="qcu-panel__body">
        <p class="qcu-hint">
            Deletes <strong>every</strong> reservation (with members and history) and
            <strong>every</strong> notification, and resets all students' strikes and
            restrictions. Accounts are kept.
        </p>

        <form method="post" action="@Url.Action("ClearAllReservations")"
              onsubmit="return confirm('This deletes EVERY reservation and notification and resets all strikes. It cannot be undone. Continue?');">
            @Html.AntiForgeryToken()
            <label for="confirmText">Type DELETE to confirm</label>
            <input id="confirmText" name="confirmText" type="text" class="form-control"
                   autocomplete="off" placeholder="DELETE" />
            <label class="qcu-check">
                <input type="checkbox" name="confirmCheck" value="true" required="required" />
                I understand this cannot be undone.
            </label>
            <button type="submit" class="qcu-btn qcu-btn--sm qcu-btn--danger">
                Clear ALL reservations and notifications
            </button>
        </form>
    </div>
</section>
