@model BSIT3D_GUADES_Project_MVC.QCUCRAM_ViewModels.QCUCRAMDevToolsViewModel
@using System
@using System.Globalization
@{
    /* =====================================================================
       QCU-CRAM  |  Views/Admin/QCU-CRAM_DevTools.cshtml
       ---------------------------------------------------------------------
       Port of Guades_QCUCram_Admin/Guades_QCUCram_DevTools.aspx.

       Four panels, same as the original:
         1. the simulated clock (shift forward/back, reset to real time);
         2. the maintenance sweep (the no-show / expiry job, run by hand);
         3. sample data generation (students, reservations);
         4. the danger zone (clear sample reservations, delete sample
            students, wipe every reservation).

       The whole page is hidden when QCU-CRAM_DevToolsEnabled is false in
       Web.config - the controller returns 404 in that case.
       ===================================================================== */

    ViewBag.Title = "Dev Tools";
    Layout = "~/Views/Shared/_QCU-CRAM_Layout.cshtml";

    CultureInfo inv = CultureInfo.InvariantCulture;
    bool shifted = Model.OffsetMinutes != 0;
}

<div class="qcu-page-head">
    <div>
        <h1 class="qcu-page-title">Dev Tools</h1>
        <p class="qcu-page-sub">Test-only helpers. Never enable these on the live site.</p>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.LastResult))
{
    <div class="qcu-alert qcu-alert--success" role="status">@Model.LastResult</div>
}

@if (!string.IsNullOrWhiteSpace(Model.LastSweepSummary))
{
    <div class="qcu-alert qcu-alert--info" role="status">@Model.LastSweepSummary</div>
}

<div class="qcu-card-grid">
    <div class="qcu-stat">
        <span class="qcu-stat__label">Students</span>
        <span class="qcu-stat__value">@Model.Students</span>
        <span class="qcu-stat__hint">@Model.SampleStudents sample account(s)</span>
    </div>
    <div class="qcu-stat">
        <span class="qcu-stat__label">Reservations</span>
        <span class="qcu-stat__value">@Model.Reservations</span>
        <span class="qcu-stat__hint">@Model.SampleReservations sample booking(s)</span>
    </div>
    <div class="qcu-stat">
        <span class="qcu-stat__label">Restricted</span>
        <span class="qcu-stat__value">@Model.SampleRestricted</span>
        <span class="qcu-stat__hint">@Model.SampleOneStrikeAway one strike away</span>
    </div>
    <div class="qcu-stat">
        <span class="qcu-stat__label">Notifications</span>
        <span class="qcu-stat__value">@Model.Notifications</span>
        <span class="qcu-stat__hint">rows in the notification table</span>
    </div>
</div>

@* ---------------------------------------------------------------- clock *@
<section class="qcu-panel">
    <header class="qcu-panel__head">
        <h2>Simulated clock</h2>
        @if (shifted)
        {
            <span class="qcu-badge is-pending">shifted</span>
        }
    </header>

    <div class="qcu-panel__body">
        <table class="qcu-table qcu-table--kv">
            <tbody>
                <tr>
                    <th>Real time</th>
                    <td>@Model.RealNow.ToString("dddd, MMMM d, yyyy h:mm tt", inv)</td>
                </tr>
                <tr>
                    <th>Site time</th>
                    <td><strong>@Model.SimulatedNow.ToString("dddd, MMMM d, yyyy h:mm tt", inv)</strong></td>
                </tr>
                <tr>
                    <th>Offset</th>
                    <td>@Model.OffsetMinutes minute(s)</td>
                </tr>
            </tbody>
        </table>

        <div class="qcu-btn-row">
            <form method="post" action="@Url.Action("ShiftClock")">
                @Html.AntiForgeryToken()
                <input type="hidden" name="command" value="-1440" />
                <button type="submit" class="qcu-btn qcu-btn--sm">&minus; 1 day</button>
            </form>
            <form method="post" action="@Url.Action("ShiftClock")">
                @Html.AntiForgeryToken()
                <input type="hidden" name="command" value="-60" />
                <button type="submit" class="qcu-btn qcu-btn--sm">&minus; 1 hour</button>
            </form>
            <form method="post" action="@Url.Action("ShiftClock")">
                @Html.AntiForgeryToken()
                <input type="hidden" name="command" value="-10" />
                <button type="submit" class="qcu-btn qcu-btn--sm">&minus; 10 min</button>
            </form>
            <form method="post" action="@Url.Action("ShiftClock")">
                @Html.AntiForgeryToken()
                <input type="hidden" name="command" value="10" />
                <button type="submit" class="qcu-btn qcu-btn--sm">+ 10 min</button>
            </form>
            <form method="post" action="@Url.Action("ShiftClock")">
                @Html.AntiForgeryToken()
                <input type="hidden" name="command" value="60" />
                <button type="submit" class="qcu-btn qcu-btn--sm">+ 1 hour</button>
            </form>
            <form method="post" action="@Url.Action("ShiftClock")">
                @Html.AntiForgeryToken()
                <input type="hidden" name="command" value="1440" />
                <button type="submit" class="qcu-btn qcu-btn--sm">+ 1 day</button>
            </form>
            <form method="post" action="@Url.Action("ShiftClock")">
                @Html.AntiForgeryToken()
                <input type="hidden" name="command" value="reset" />
                <button type="submit" class="qcu-btn qcu-btn--sm qcu-btn--danger">Reset to real time</button>
            </form>
        </div>
    </div>
</section>

@* ---------------------------------------------------------------- sweep *@
<section class="qcu-panel">
    <header class="qcu-panel__head">
        <h2>Maintenance sweep</h2>
    </header>

    <div class="qcu-panel__body">
        <p class="qcu-hint">
            Expires yesterday's un-checked-in bookings, lifts finished restrictions and
            queues the notifications. The site runs this on a timer; use the button to
            run it now.
        </p>

        <form method="post" action="@Url.Action("RunSweep")">
            @Html.AntiForgeryToken()
            <button type="submit" class="qcu-btn qcu-btn--primary">Run sweep now</button>
        </form>
    </div>
</section>

@* ---------------------------------------------------------- sample data *@
<section class="qcu-panel">
    <header class="qcu-panel__head">
        <h2>Sample data</h2>
    </header>

    <div class="qcu-panel__body">
        <p class="qcu-hint">
            Sample students are tagged with the <code>@@cram.test</code> e-mail domain and
            sample reservations with the <code>SAMPLE - </code> purpose prefix, so they can
            be removed again without touching real records.
        </p>

        <div class="qcu-btn-row">
            <form method="post" action="@Url.Action("GenerateStudents")">
                @Html.AntiForgeryToken()
                <button type="submit" class="qcu-btn qcu-btn--sm">Add 10 sample students</button>
            </form>

            <form method="post" action="@Url.Action("GenerateReservations")" class="qcu-inline-form">
                @Html.AntiForgeryToken()
                <label for="daysBack">Days back</label>
                <input id="daysBack" name="daysBack" type="number" min="0" max="60" value="7"
                       class="form-control qcu-input--num" />
                <label for="daysAhead">Days ahead</label>
                <input id="daysAhead" name="daysAhead" type="number" min="0" max="60" value="14"
                       class="form-control qcu-input--num" />
                <button type="submit" class="qcu-btn qcu-btn--sm">Generate reservations</button>
            </form>
        </div>
    </div>
</section>

@* --------------------------------------------------------- danger zone *@
<section class="qcu-panel qcu-panel--danger">
    <header class="qcu-panel__head">
        <h2>Danger zone</h2>
    </header>

    <div class="qcu-panel__body">
        <div class="qcu-btn-row qcu-btn-row--danger">
            <form method="post" action="@Url.Action("ClearSampleReservations")"
                  onsubmit="return confirm('Delete every SAMPLE reservation?');">
                @Html.AntiForgeryToken()
                <button type="submit" class="qcu-btn qcu-btn--sm qcu-btn--danger">Clear sample reservations</button>
            </form>

            <form method="post" action="@Url.Action("DeleteSampleStudents")"
                  onsubmit="return confirm('Delete every sample student and their reservations?');">
                @Html.AntiForgeryToken()
                <button type="submit" class="qcu-btn qcu-btn--sm qcu-btn--danger">Delete sample students</button>
            </form>

            <form method="post" action="@Url.Action("ClearAllReservations")"
                  onsubmit="return confirm('Delete EVERY reservation, sample or not? This cannot be undone.');">
                @Html.AntiForgeryToken()
                <button type="submit" class="qcu-btn qcu-btn--sm qcu-btn--danger">Delete all reservations</button>
            </form>
        </div>
    </div>
</section>
