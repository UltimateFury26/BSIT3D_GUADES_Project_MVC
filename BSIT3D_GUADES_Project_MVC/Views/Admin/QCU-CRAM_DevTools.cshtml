@model BSIT3D_GUADES_Project_MVC.QCUCRAM_ViewModels.QCUCRAMDevToolsViewModel
@using System
@using System.Globalization
@{
    /* =====================================================================
       QCU-CRAM  |  Views/Admin/QCU-CRAM_DevTools.cshtml
       One-to-one port of Guades_QCUCram_Admin/Guades_QCUCram_DevTools.aspx:
       same page head, warning alert, "System clock" / "Automatic rules" /
       "Sample data" sub-heads, bootstrap tables and buttons, drop-downs,
       qcuConfirm pop-ups and the "Danger zone" card.

       R07 notes:
         * One POST form, like the Web Forms form: every button carries its own
           formaction, so every tool is POST-only and anti-forgery protected.
         * Original confirms are qcuConfirm pop-ups; the "I understand this
           cannot be undone." tick box is the pop-up's requireCheck.
         * Messages: toasts (lblMessage) come from TempData through the layout;
           the sweep result and the sample-data details stay on the page.
       ===================================================================== */
    ViewBag.Title = "Dev Tools";
    Layout = "~/Views/Shared/_QCU-CRAM_Layout.cshtml";

    CultureInfo inv = CultureInfo.InvariantCulture;
    string stamp = "ddd, MMM d, yyyy h:mm:ss tt";
}

<div class="qcu-page-head">
    <h2>Dev Tools</h2>
    <p>Testing tools - not for normal use</p>
</div>

@if (!string.IsNullOrWhiteSpace(Model.LoadError))
{
    <div class="alert alert-danger" role="alert">@Model.LoadError</div>
}

<div class="alert alert-warning">
    Testing tools only. Moving the clock changes how every page decides what is "now".
    <strong>Reset the clock when you finish testing.</strong>
</div>

@using (Html.BeginForm("ShiftClock", "AdminSetup", FormMethod.Post))
{
    @Html.AntiForgeryToken()

    @* ================= Clock ================= *@
    <h5 class="qcu-subhead">System clock</h5>
    <table class="table table-sm table-bordered w-auto"><tr><th>Real time</th><td>@Model.RealNow.ToString(stamp, inv)</td></tr><tr><th>Offset</th><td>@Model.OffsetMinutes minute(s)</td></tr><tr><th>System time (used by CRAM)</th><td><strong>@Model.SimulatedNow.ToString(stamp, inv)</strong></td></tr></table>

    <div class="mb-4">
        <button type="submit" name="command" value="15" formaction="@Url.Action("ShiftClock", "AdminSetup")" class="btn btn-outline-primary">+15 minutes</button>
        <button type="submit" name="command" value="60" formaction="@Url.Action("ShiftClock", "AdminSetup")" class="btn btn-outline-primary">+1 hour</button>
        <button type="submit" name="command" value="1440" formaction="@Url.Action("ShiftClock", "AdminSetup")" class="btn btn-outline-primary">+1 day</button>
        <button type="submit" name="command" value="10080" formaction="@Url.Action("ShiftClock", "AdminSetup")" class="btn btn-outline-primary">+1 week</button>
        <button type="submit" name="command" value="reset" formaction="@Url.Action("ShiftClock", "AdminSetup")" class="btn btn-danger">Reset clock</button>
    </div>

    @* ================= Sweep ================= *@
    <h5 class="qcu-subhead">Automatic rules</h5>
    <p class="text-muted small">
        Runs: expire unreviewed pending requests, forfeit unclaimed bookings (adds strikes and restrictions),
        complete finished sessions, and lift expired restrictions.
    </p>
    <button type="submit" formaction="@Url.Action("RunSweep", "AdminSetup")" class="btn btn-primary">Run sweep now</button>
    <div class="mt-3 mb-4">
        if (!string.IsNullOrWhiteSpace(Model.LastSweepSummary))
        {
            @Html.Raw(Model.LastSweepSummary)
        }
    </div>

    @* ================= Sample data ================= *@
    <h5 class="qcu-subhead">Sample data</h5>
    <table class="table table-sm table-bordered w-auto"><tr><th>Students</th><td>@Model.Students (@Model.SampleStudents sample: @Model.SampleRestricted restricted now, @Model.SampleOneStrikeAway one strike away)</td></tr><tr><th>Reservations</th><td>@Model.Reservations (@Model.SampleReservations sample)</td></tr><tr><th>Notifications</th><td>@Model.Notifications</td></tr></table>

    if (!string.IsNullOrWhiteSpace(Model.LastResult))
    {
        @Html.Raw(Model.LastResult)
    }

    <div class="mb-3">
        <button type="submit" formaction="@Url.Action("GenerateStudents", "AdminSetup")" class="btn btn-outline-primary">Generate 10 sample students</button>
        <span class="text-muted small ms-2">
            Each click adds 10 <strong>new</strong> students (no limit). IDs look real: <code>24-0153</code>
            (Faculty <code>FAC-0123</code>, Visitor <code>VIS-0123</code>). Password for all: <code>Test1234!</code>
        </span>
        <div class="text-muted small mt-1">
            Every batch of 10: 4 clean &middot; 3 one strike away &middot; 2 restricted now &middot; 1 expired restriction
            (the strike limit and restriction days come from Settings).
        </div>
    </div>

    <div class="qcu-toolbar row g-2 align-items-end mb-3">
        <div class="col-auto">
            <label for="daysBack" class="form-label">History to generate</label>
            <select id="daysBack" name="daysBack" class="form-select">
                <option value="14">Last 14 days</option>
                <option value="30" selected="selected">Last 30 days</option>
                <option value="60">Last 60 days</option>
            </select>
        </div>
        <div class="col-auto">
            <label for="daysAhead" class="form-label">Days ahead</label>
            <select id="daysAhead" name="daysAhead" class="form-select">
                <option value="14" selected="selected">Next 14 days</option>
                <option value="21">Next 21 days</option>
                <option value="30">Next 30 days</option>
            </select>
        </div>
        <div class="col-auto">
            <button type="submit" formaction="@Url.Action("GenerateReservations", "AdminSetup")" class="btn btn-outline-primary">Generate sample reservations</button>
        </div>
    </div>
    <div class="text-muted small mb-3">
        Covers all 8 statuses, every room, past days and at least 14 days ahead. They follow the automatic rules, so the sweep leaves them alone
        (a <em>CheckedIn</em> one needs a slot that is running right now &mdash; use the clock buttons above to move into library hours).
    </div>

    <div class="mb-4">
        <button type="submit" formaction="@Url.Action("ClearSampleReservations", "AdminSetup")" class="btn btn-outline-secondary"
                onclick="return qcuConfirm(this, { tone: 'warning', title: 'Clear sample reservations?', message: 'Every SAMPLE reservation is deleted. Your own bookings are kept.', confirmText: 'Clear' });">Clear sample reservations</button>
        <button type="submit" formaction="@Url.Action("DeleteSampleStudents", "AdminSetup")" class="btn btn-outline-secondary"
                onclick="return qcuConfirm(this, { tone: 'danger', title: 'Delete sample students?', message: 'Every SAMPLE student and everything that belongs to them is deleted.', confirmText: 'Delete' });">Delete sample students and their data</button>
    </div>

    @* ================= Danger zone ================= *@
    <div class="card border-danger mb-5">
        <div class="card-header text-danger"><strong>Danger zone</strong></div>
        <div class="card-body">
            <p class="mb-2">
                Deletes <strong>every</strong> reservation (with members and history) and <strong>every</strong> notification,
                and resets all students' strikes and restrictions. Accounts are kept.
            </p>
            <div class="row g-2 align-items-end">
                <div class="col-auto">
                    <label for="confirmText" class="form-label">Type DELETE to confirm</label>
                    <input type="text" id="confirmText" name="confirmText" class="form-control" autocomplete="off" />
                </div>
                <div class="col-auto">
                    <button type="submit" formaction="@Url.Action("ClearAllReservations", "AdminSetup")" class="btn btn-danger"
                            onclick="return qcuConfirm(this, { tone: 'danger', title: 'Clear ALL reservations?', message: 'This deletes every reservation and every notification, and resets all strikes and restrictions. Accounts are kept.', confirmText: 'Clear everything', requireCheck: 'I understand this cannot be undone.' });">Clear ALL reservations and notifications</button>
                </div>
            </div>
        </div>
    </div>
}
