@model BSIT3D_GUADES_Project_MVC.QCUCRAM_ViewModels.QCUCRAMRoomsViewModel
@using System
@using System.Collections.Generic
@{
    /* =====================================================================
       QCU-CRAM  |  Views/Admin/QCU-CRAM_Rooms.cshtml
       One-to-one port of Guades_QCUCram_Admin/Guades_QCUCram_Rooms.aspx:
       same page bar, GridView table classes, badges, confirm pop-ups,
       help note and Add / Edit pop-up markup.
       ===================================================================== */
    ViewBag.Title = "Rooms";
    Layout = "~/Views/Shared/_QCU-CRAM_Layout.cshtml";

    bool isNew = Model.Edit == null || Model.Edit.RoomID <= 0;
    string modalTitle = isNew ? "Add Room" : "Edit Room #" + Model.Edit.RoomID;

    List<string> nameErrors = Model.Edit == null ? new List<string>() : Model.Edit.NameErrors;
    List<string> minErrors = Model.Edit == null ? new List<string>() : Model.Edit.MinErrors;
    List<string> maxErrors = Model.Edit == null ? new List<string>() : Model.Edit.MaxErrors;
}

<div class="qcu-page-bar">
    <div class="qcu-page-head">
        <h2>Rooms</h2>
        <p>Collaboration rooms available for booking</p>
    </div>
    <a class="btn btn-primary qcu-add-btn" href="@Url.Action("Rooms", new { edit = 0 })">+ Add Room</a>
</div>

<div class="table-responsive">
    @if (Model.Rows.Count == 0)
    {
        @* GridView EmptyDataText: just the message, no header row *@
        <table class="table table-bordered table-striped qcu-admin-table">
            <tr><td>No rooms yet. Click &quot;+ Add Room&quot; to create one.</td></tr>
        </table>
    }
    else
    {
    <table class="table table-bordered table-striped qcu-admin-table">
        <thead>
            <tr><th>ID</th><th>Room Name</th><th>Min Capacity</th><th>Max Capacity</th><th>Status</th><th>Reservations</th><th>Actions</th></tr>
        </thead>
        <tbody>
            @foreach (var row in Model.Rows)
            {
                string action = row.IsActive ? "Disable" : "Enable";
                <tr>
                    <td>@row.RoomID</td>
                    <td>@row.RoomName</td>
                    <td>@row.MinCapacity</td>
                    <td>@row.MaxCapacity</td>
                    <td>
                        @if (row.IsActive) { <span class="badge text-bg-success">Active</span> }
                        else { <span class="badge text-bg-secondary">Disabled</span> }
                    </td>
                    <td>@row.ReservationCount</td>
                    <td class="qcu-actions-cell">
                        <div class="qcu-actions">
                            <a class="btn btn-sm btn-outline-primary" href="@Url.Action("Rooms", new { edit = row.RoomID })">Edit</a>
                            <form method="post" action="@Url.Action("ToggleRoom", new { id = row.RoomID })" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-secondary"
                                        onclick="return qcuConfirm(this, { tone: 'warning', title: '@action this room?', message: 'A disabled room cannot be booked. You can change this again at any time.', confirmText: '@action' });">@action</button>
                            </form>
                            @if (row.CanDelete)
                            {
                                <form method="post" action="@Url.Action("DeleteRoom", new { id = row.RoomID })" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger"
                                            onclick="return qcuConfirm(this, { tone: 'danger', title: 'Delete this room?', message: 'The room is removed permanently. This cannot be undone.', confirmText: 'Delete' });">Delete</button>
                                </form>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    }
</div>
<p class="text-muted">
    A room that has reservations cannot be deleted. Disable it instead: it disappears from new bookings,
    but existing reservations still display.
</p>

@Html.Partial("~/Views/Admin/_QCU-CRAM_SetupModal.cshtml", new BSIT3D_GUADES_Project_MVC.QCUCRAM_ViewModels.QCUCRAM_SetupModalViewModel
{
    Open = Model.ModalOpen,
    Title = modalTitle,
    Action = Url.Action("SaveRoom"),
    Error = Model.ModalError,
    SubmitText = isNew ? "Add Room" : "Update Room",
    Needs = "#RoomName|#MinCapacity|#MaxCapacity",
    CancelUrl = Url.Action("Rooms"),
    Body = @<text>
        <input type="hidden" name="RoomID" value="@(isNew ? 0 : Model.Edit.RoomID)" />

        <div class="mb-3">
            <label class="form-label" for="RoomName">Room Name</label>
            <input id="RoomName" name="RoomName" class="form-control" maxlength="50" autocomplete="off"
                   value="@(Model.Edit == null ? string.Empty : Model.Edit.RoomName)" />
            @foreach (string m in nameErrors) { <span class="text-danger">@m</span> }
        </div>

        <div class="row">
            <div class="col-6 mb-3">
                <label class="form-label" for="MinCapacity">Min Capacity</label>
                <input id="MinCapacity" name="MinCapacity" class="form-control" maxlength="3" autocomplete="off"
                       value="@(Model.Edit == null ? "5" : Model.Edit.MinCapacity)" />
                @foreach (string m in minErrors) { <span class="text-danger">@m</span> }
            </div>
            <div class="col-6 mb-3">
                <label class="form-label" for="MaxCapacity">Max Capacity</label>
                <input id="MaxCapacity" name="MaxCapacity" class="form-control" maxlength="3" autocomplete="off"
                       value="@(Model.Edit == null ? "10" : Model.Edit.MaxCapacity)" />
                @foreach (string m in maxErrors) { <span class="text-danger">@m</span> }
            </div>
        </div>

        <div class="form-check mb-3">
            <input type="checkbox" class="form-check-input" id="IsActive" name="IsActive" value="true" @Html.Raw(Model.Edit == null || Model.Edit.IsActive ? "checked=\"checked\"" : string.Empty) />
            <label class="form-check-label" for="IsActive">Active (available for booking)</label>
            @* R02: an unticked box posts nothing, so the model kept its constructor default (true) and
               "Active" could never be turned off. The hidden false must come AFTER the checkbox. *@
            <input type="hidden" name="IsActive" value="false" />
        </div>
    </text>
})
