@model BSIT3D_GUADES_Project_MVC.QCUCRAM_ViewModels.QCUCRAMReservationDetailViewModel
@using System
@using System.Globalization
@{
    /* =====================================================================
       QCU-CRAM  |  Views/Admin/_QCU-CRAM_ReservationDetail.cshtml
       ---------------------------------------------------------------------
       The read-only body of the Records detail pop-up. Port of the block
       Records.aspx.cs ShowDetail() built:

         summary table   Requester / ID / Email / Program / Room / Date / Time /
                         Members / Purpose / Status / Submitted / Checked in
         Group members   No. + Name
         Status history  When / Change / By / Notes, in HistoryID order
       ===================================================================== */

    CultureInfo inv = CultureInfo.InvariantCulture;

    string requester = Model.RequesterName +
                       (string.IsNullOrWhiteSpace(Model.RequesterType)
                            ? string.Empty
                            : " (" + Model.RequesterType + ")");

    string checkedIn = Model.CheckedInAt.HasValue
        ? Model.CheckedInAt.Value.ToString("MMM d, yyyy h:mm tt", inv)
        : "-";
}

<table class="table table-sm table-bordered w-auto mb-0">
    <tbody>
        <tr><th>Requester</th><td>@requester</td></tr>
        <tr><th>ID / Student No.</th><td>@Model.StudentNumber</td></tr>
        <tr><th>Email</th><td>@Model.Email</td></tr>
        <tr><th>Program</th><td>@Model.Program</td></tr>
        <tr><th>Room</th><td>@Model.RoomName</td></tr>
        <tr><th>Date</th><td>@Model.ReservationDate.ToString("dddd, MMM d, yyyy", inv)</td></tr>
        <tr><th>Time</th><td>@Model.SlotLabel</td></tr>
        <tr><th>Members</th><td>@Model.NumberOfMembers</td></tr>
        <tr><th>Purpose</th><td>@Model.Purpose</td></tr>
        <tr><th>Status</th><td><span class="badge @Model.StatusCss">@(Model.Status == "CheckedIn" ? "Checked In" : Model.Status)</span></td></tr>
        <tr><th>Submitted</th><td>@Model.CreatedAt.ToString("MMM d, yyyy h:mm tt", inv)</td></tr>
        <tr><th>Checked in</th><td>@checkedIn</td></tr>
    </tbody>
</table>

<h6 class="mt-4">Group members</h6>
<table class="table table-sm table-bordered table-striped w-auto">
    <thead>
        <tr><th>No.</th><th>Name</th></tr>
    </thead>
    <tbody>
        @if (Model.Members.Count == 0)
        {
            <tr><td colspan="2" class="text-muted">No members recorded.</td></tr>
        }
        else
        {
            int n = 0;
            foreach (var m in Model.Members)
            {
                n++;
                <tr><td>@n</td><td>@m.FullName</td></tr>
            }
        }
    </tbody>
</table>

<h6 class="mt-4">Status history</h6>
<table class="table table-sm table-bordered table-striped">
    <thead>
        <tr><th>When</th><th>Change</th><th>By</th><th>Notes</th></tr>
    </thead>
    <tbody>
        @if (Model.History.Count == 0)
        {
            <tr><td colspan="4" class="text-muted">No history recorded.</td></tr>
        }
        else
        {
            foreach (var h in Model.History)
            {
                string from = string.IsNullOrEmpty(h.FromStatus) ? "(new)" : h.FromStatus;
                // Records.aspx.cs: "Admin: name", "Student: name", anything else "System".
                string by = string.IsNullOrEmpty(h.ActorName) ? "System" : h.ActorRole + ": " + h.ActorName;

                <tr>
                    <td>@h.ChangedAt.ToString("MMM d, yyyy h:mm:ss tt", inv)</td>
                    <td>@from &rarr; @h.ToStatus</td>
                    <td>@by</td>
                    <td>@(string.IsNullOrEmpty(h.Note) ? "-" : h.Note)</td>
                </tr>
            }
        }
    </tbody>
</table>
