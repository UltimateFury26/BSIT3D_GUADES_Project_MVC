@model BSIT3D_GUADES_Project_MVC.QCUCRAM_ViewModels.QCUCRAMRecordsViewModel
@using System
@using System.Globalization
@{
    /* =====================================================================
       QCU-CRAM  |  Views/Admin/QCU-CRAM_Records.cshtml
       ---------------------------------------------------------------------
       Port of Guades_QCUCram_Admin/Guades_QCUCram_Records.aspx.

         filter bar       From date, To date, Status, Room, Program,
                          Student (name or number)
         sortable grid    gvRecords - eight sort keys, whitelisted server-side
         pager            PageSize = 20
         "Export to CSV"  same filters, every page, not just this one
         details pop-up   summary + group members + status history

       The Web Forms page kept all of this in ViewState. Here it is the query
       string, so a filtered list can be bookmarked and shared.
       ===================================================================== */

    ViewBag.Title = "Reservation Records";
    Layout = "~/Views/Shared/_QCU-CRAM_Layout.cshtml";

    CultureInfo inv = CultureInfo.InvariantCulture;

    var f = Model.Filter;

    string fromText = f.From.HasValue ? f.From.Value.ToString("yyyy-MM-dd", inv) : null;
    string toText = f.To.HasValue ? f.To.Value.ToString("yyyy-MM-dd", inv) : null;
    string roomText = f.RoomID.HasValue ? f.RoomID.Value.ToString(inv) : null;

    Func<string, string> sortUrl = key => Url.Action("Index", "AdminRecords", new
    {
        status = f.Status,
        room = roomText,
        program = f.Program,
        from = fromText,
        to = toText,
        q = f.Search,
        sort = key,
        dir = (f.Sort == key && f.Dir == "asc") ? "desc" : "asc",
        page = 1
    });

    Func<string, string> arrow = key =>
        f.Sort != key ? string.Empty : (f.Dir == "asc" ? " \u25B2" : " \u25BC");

    Func<int, string> detailUrl = id => Url.Action("Index", "AdminRecords", new
    {
        status = f.Status,
        room = roomText,
        program = f.Program,
        from = fromText,
        to = toText,
        q = f.Search,
        sort = f.Sort,
        dir = f.Dir,
        page = f.Page,
        detail = id
    });

    string closeUrl = Url.Action("Index", "AdminRecords", new
    {
        status = f.Status,
        room = roomText,
        program = f.Program,
        from = fromText,
        to = toText,
        q = f.Search,
        sort = f.Sort,
        dir = f.Dir,
        page = f.Page
    });
}

<div class="qcu-page-head">
    <h2>Reservation Records</h2>
    <p>Search, review and export every reservation</p>
</div>

<form method="get" action="@Url.Action("Index", "AdminRecords")" class="qcu-toolbar mb-3">
    <div class="row g-3">
        <div class="col-md-3">
            <label class="form-label" for="txtFrom">From date</label>
            <input class="form-control" type="date" id="txtFrom" name="from" value="@fromText" />
        </div>
        <div class="col-md-3">
            <label class="form-label" for="txtTo">To date</label>
            <input class="form-control" type="date" id="txtTo" name="to" value="@toText" />
        </div>
        <div class="col-md-3">
            <label class="form-label" for="ddlStatus">Status</label>
            <select class="form-select" id="ddlStatus" name="status">
                @foreach (var o in Model.StatusOptions)
                {
                    <option value="@o.Key" selected="@(o.Key == f.Status ? "selected" : null)">@o.Value</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label" for="ddlRoom">Room</label>
            <select class="form-select" id="ddlRoom" name="room">
                @foreach (var o in Model.RoomOptions)
                {
                    <option value="@o.Key" selected="@(o.Key == roomText ? "selected" : null)">@o.Value</option>
                }
            </select>
        </div>
        <div class="col-md-4">
            <label class="form-label" for="ddlProgram">Program</label>
            <select class="form-select" id="ddlProgram" name="program">
                <option value="">All programs</option>
                @foreach (var p in Model.ProgramOptions)
                {
                    <option value="@p" selected="@(p == f.Program ? "selected" : null)">@p</option>
                }
            </select>
        </div>
        <div class="col-md-4">
            <label class="form-label" for="txtStudent">Student (name or number)</label>
            <input class="form-control" type="text" id="txtStudent" name="q" value="@f.Search"
                   maxlength="100" autocomplete="off" placeholder="e.g. Santos or 24-00123" />
        </div>
        <div class="col-md-4 d-flex align-items-end flex-wrap gap-2">
            <input type="hidden" name="sort" value="@f.Sort" />
            <input type="hidden" name="dir" value="@f.Dir" />

            <button type="submit" class="btn btn-primary">Apply Filters</button>
            <a class="btn btn-outline-secondary" href="@Url.Action("Index", "AdminRecords")">Clear</a>
            <a class="btn btn-success"
               href="@Url.Action("ExportCsv", "AdminRecords", new {
                          status = f.Status, room = roomText, program = f.Program,
                          from = fromText, to = toText, q = f.Search,
                          sort = f.Sort, dir = f.Dir })">
                Export to CSV
            </a>
        </div>
    </div>
</form>

@if (!string.IsNullOrEmpty(Model.FilterError))
{
    <div class="alert alert-danger">@Model.FilterError</div>
}

<p class="text-muted">
    @if (string.IsNullOrEmpty(Model.FilterError))
    {
        @(f.HasFilters
              ? Model.TotalRows + " reservation(s) match the filters."
              : Model.TotalRows + " reservation(s) in total.")
    }
</p>

<div class="table-responsive">
    <table class="table table-bordered table-striped align-middle qcu-admin-table">
        <thead>
            <tr>
                <th><a href="@sortUrl("ReservationID")">#@arrow("ReservationID")</a></th>
                <th><a href="@sortUrl("ReservationDate")">Date@arrow("ReservationDate")</a></th>
                <th><a href="@sortUrl("StartTime")">Time@arrow("StartTime")</a></th>
                <th><a href="@sortUrl("RoomName")">Room@arrow("RoomName")</a></th>
                <th>ID / Student No.</th>
                <th><a href="@sortUrl("Requester")">Requester@arrow("Requester")</a></th>
                <th><a href="@sortUrl("Program")">Program@arrow("Program")</a></th>
                <th><a href="@sortUrl("NumberOfMembers")">Members@arrow("NumberOfMembers")</a></th>
                <th><a href="@sortUrl("Status")">Status@arrow("Status")</a></th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Rows.Count == 0)
            {
                <tr>
                    <td colspan="10" class="text-muted">No reservations match these filters.</td>
                </tr>
            }
            else
            {
                foreach (var row in Model.Rows)
                {
                    <tr>
                        <td>@row.ReservationID</td>
                        <td>@row.ReservationDate.ToString("ddd, MMM d, yyyy", inv)</td>
                        <td>@row.SlotLabel</td>
                        <td>@row.RoomName</td>
                        <td>@row.StudentNumber</td>
                        <td>@row.Requester</td>
                        <td>@row.Program</td>
                        <td>@row.NumberOfMembers</td>
                        <td><span class="badge @row.StatusCss">@(row.Status == "CheckedIn" ? "Checked In" : row.Status)</span></td>
                        <td>
                            <a class="btn btn-sm btn-outline-primary me-2" href="@detailUrl(row.ReservationID)">Details</a>
                            <a class="btn btn-sm btn-outline-secondary"
                               href="@Url.Action("PrintBooking", "Reports", new { id = row.ReservationID })"
                               target="_blank">Print</a>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@if (Model.Rows.Count > 0)
{
    @Html.Partial("_QCU-CRAM_Pager", Model.Pager)
}

@if (Model.Detail != null)
{
    <div class="qcu-form-overlay is-open">
        <div class="qcu-form-modal qcu-form-modal-lg" role="dialog" aria-modal="true"
             aria-labelledby="detailModalTitle" tabindex="-1">

            <div class="qcu-form-head">
                <div class="qcu-form-title" id="detailModalTitle">Reservation #@Model.Detail.ReservationID</div>
                <a class="qcu-form-close" href="@closeUrl" aria-label="Close">&times;</a>
            </div>

            <div class="qcu-form-body">
                @Html.Partial("_QCU-CRAM_ReservationDetail", Model.Detail)
            </div>

            <div class="qcu-form-foot">
                <a class="btn btn-outline-secondary" href="@closeUrl">Close</a>
                <a class="btn btn-primary"
                   href="@Url.Action("PrintBooking", "Reports", new { id = Model.Detail.ReservationID })"
                   target="_blank">Printable report</a>
            </div>
        </div>
    </div>
}
