@model BSIT3D_GUADES_Project_MVC.QCUCRAM_ViewModels.QCUCRAMTimeSlotsViewModel
@using System
@using System.Collections.Generic
@using System.Globalization
@{
    /* =====================================================================
       QCU-CRAM  |  Views/Admin/QCU-CRAM_TimeSlots.cshtml
       One-to-one port of Guades_QCUCram_Admin/Guades_QCUCram_TimeSlots.aspx.
       ===================================================================== */
    ViewBag.Title = "Time Slots";
    Layout = "~/Views/Shared/_QCU-CRAM_Layout.cshtml";

    bool isNew = Model.Edit == null || Model.Edit.TimeSlotID <= 0;
    string modalTitle = isNew ? "Add Time Slot" : "Edit Time Slot #" + Model.Edit.TimeSlotID;
    CultureInfo inv = CultureInfo.InvariantCulture;
    Func<TimeSpan, string> fmt = t => DateTime.Today.Add(t).ToString("h:mm tt", inv);

    List<string> startErrors = Model.Edit == null ? new List<string>() : Model.Edit.StartErrors;
    List<string> endErrors = Model.Edit == null ? new List<string>() : Model.Edit.EndErrors;
}

<div class="qcu-page-bar">
    <div class="qcu-page-head">
        <h2>Time Slots</h2>
        <p>The bookable hours for each day</p>
    </div>
    <a class="btn btn-primary qcu-add-btn" href="@Url.Action("TimeSlots", new { edit = 0 })">+ Add Time Slot</a>
</div>

<div class="table-responsive">
    @if (Model.Rows.Count == 0)
    {
        @* GridView EmptyDataText: just the message, no header row *@
        <table class="table table-bordered table-striped qcu-admin-table">
            <tr><td>No time slots yet. Click &quot;+ Add Time Slot&quot; to create one.</td></tr>
        </table>
    }
    else
    {
    <table class="table table-bordered table-striped qcu-admin-table">
        <thead>
            <tr><th>ID</th><th>Time Slot</th><th>Status</th><th>Reservations</th><th>Actions</th></tr>
        </thead>
        <tbody>
            @foreach (var row in Model.Rows)
            {
                string action = row.IsActive ? "Disable" : "Enable";
                <tr>
                    <td>@row.TimeSlotID</td>
                    <td>@(fmt(row.StartTime) + " \u2013 " + fmt(row.EndTime))</td>
                    <td>
                        @if (row.IsActive) { <span class="badge text-bg-success">Active</span> }
                        else { <span class="badge text-bg-secondary">Disabled</span> }
                    </td>
                    <td>@row.ReservationCount</td>
                    <td class="qcu-actions-cell">
                        <div class="qcu-actions">
                            <a class="btn btn-sm btn-outline-primary" href="@Url.Action("TimeSlots", new { edit = row.TimeSlotID })">Edit</a>
                            <form method="post" action="@Url.Action("ToggleSlot", new { id = row.TimeSlotID })" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-secondary"
                                        onclick="return qcuConfirm(this, { tone: 'warning', title: '@action this time slot?', message: 'A disabled time slot cannot be booked. You can change this again at any time.', confirmText: '@action' });">@action</button>
                            </form>
                            @if (row.CanDelete)
                            {
                                <form method="post" action="@Url.Action("DeleteSlot", new { id = row.TimeSlotID })" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger"
                                            onclick="return qcuConfirm(this, { tone: 'danger', title: 'Delete this time slot?', message: 'The time slot is removed permanently. This cannot be undone.', confirmText: 'Delete' });">Delete</button>
                                </form>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    }
</div>
<p class="text-muted">
    A slot that has reservations cannot be deleted or have its times changed. Disable it instead:
    it disappears from new bookings, but existing reservations still display.
    Slots may touch (for example 9:00-10:00 and 10:00-11:00) but may not overlap.
</p>

@Html.Partial("~/Views/Admin/_QCU-CRAM_SetupModal.cshtml", new BSIT3D_GUADES_Project_MVC.QCUCRAM_ViewModels.QCUCRAM_SetupModalViewModel
{
    Open = Model.ModalOpen,
    Title = modalTitle,
    Action = Url.Action("SaveSlot"),
    Error = Model.ModalError,
    SubmitText = isNew ? "Add Time Slot" : "Update Time Slot",
    Needs = "#Start|#End",
    CancelUrl = Url.Action("TimeSlots"),
    Body = @<text>
        <input type="hidden" name="TimeSlotID" value="@(isNew ? 0 : Model.Edit.TimeSlotID)" />

        <div class="row">
            <div class="col-6 mb-3">
                <label class="form-label" for="Start">Start Time</label>
                <input id="Start" name="Start" type="time" class="form-control" value="@(Model.Edit == null ? string.Empty : Model.Edit.Start)" />
                @foreach (string m in startErrors) { <span class="text-danger">@m</span> }
            </div>
            <div class="col-6 mb-3">
                <label class="form-label" for="End">End Time</label>
                <input id="End" name="End" type="time" class="form-control" value="@(Model.Edit == null ? string.Empty : Model.Edit.End)" />
                @foreach (string m in endErrors) { <span class="text-danger">@m</span> }
            </div>
        </div>

        <div class="form-check mb-3">
            <input type="checkbox" class="form-check-input" id="IsActive" name="IsActive" value="true" @Html.Raw(Model.Edit == null || Model.Edit.IsActive ? "checked=\"checked\"" : string.Empty) />
            <label class="form-check-label" for="IsActive">Active (available for booking)</label>
            @* R03: an unticked box posts nothing, so the model kept its constructor default (true). Hidden false AFTER the checkbox. *@
            <input type="hidden" name="IsActive" value="false" />
        </div>
    </text>
})
