@model BSIT3D_GUADES_Project_MVC.QCUCRAM_ViewModels.QCUCRAMAdminUsersViewModel
@using System
@using System.Collections.Generic
@{
    /* =====================================================================
       QCU-CRAM  |  Views/Admin/QCU-CRAM_AdminUsers.cshtml
       One-to-one port of Guades_QCUCram_Admin/Guades_QCUCram_AdminUsers.aspx:
       same page bar, GridView table classes, badges, confirm pop-ups,
       help note and Add / Edit pop-up markup.

       R05 notes:
         * Disable / Enable and Reset Password are NOT rendered for your own
           account (Visible='<%# !IsSelf(...) %>'); Disable is never greyed
           out for "last active admin" - the source lets you click it and
           answers with the "At least one active admin..." message.
         * The username box exists only when ADDING; the Edit pop-up shows
           the full name only (pnlUsername.Visible = false).
         * The help note under the grid is always shown.
       ===================================================================== */
    ViewBag.Title = "Admin Accounts";
    Layout = "~/Views/Shared/_QCU-CRAM_Layout.cshtml";

    bool isNew = Model.Edit == null || Model.Edit.AdminID <= 0;
    string modalTitle = isNew ? "Add Admin Account" : "Edit Admin: " + Model.Edit.Username;

    List<string> userErrors = Model.Edit == null ? new List<string>() : Model.Edit.UsernameErrors;
    List<string> nameErrors = Model.Edit == null ? new List<string>() : Model.Edit.FullNameErrors;
}

<div class="qcu-page-bar">
    <div class="qcu-page-head">
        <h2>Admin Accounts</h2>
        <p>Library assistant accounts</p>
    </div>
    <a class="btn btn-primary qcu-add-btn" href="@Url.Action("AdminUsers", new { edit = 0 })">+ Add Admin Account</a>
</div>

<div class="table-responsive">
    @if (Model.Rows.Count == 0)
    {
        @* GridView EmptyDataText: just the message, no header row *@
        <table class="table table-bordered table-striped qcu-admin-table">
            <tr><td>No admin accounts found.</td></tr>
        </table>
    }
    else
    {
    <table class="table table-bordered table-striped qcu-admin-table">
        <thead>
            <tr><th>Username</th><th>Full Name</th><th>Status</th><th>Actions</th></tr>
        </thead>
        <tbody>
            @foreach (var row in Model.Rows)
            {
                string action = row.IsActive ? "Disable" : "Enable";
                // FormatUsername(): encoded username + " <span class=\"text-muted\">(you)</span>" for your own row
                string selfMark = row.IsSelf ? "<span class=\"text-muted\">(you)</span>" : string.Empty;
                <tr>
                    <td>@row.Username @Html.Raw(selfMark)</td>
                    <td>@row.FullName</td>
                    <td>
                        @if (row.IsActive) { <span class="badge text-bg-success">Active</span> }
                        else { <span class="badge text-bg-secondary">Disabled</span> }
                    </td>
                    <td class="qcu-actions-cell">
                        <div class="qcu-actions">
                            <a class="btn btn-sm btn-outline-primary" href="@Url.Action("AdminUsers", new { edit = row.AdminID })">Edit</a>
                            @if (!row.IsSelf)
                            {
                                <form method="post" action="@Url.Action("ToggleAdmin", new { id = row.AdminID })" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-secondary"
                                            onclick="return qcuConfirm(this, { tone: 'warning', title: '@action this account?', message: 'A disabled account cannot sign in. You can change this again at any time.', confirmText: '@action' });">@action</button>
                                </form>
                                <form method="post" action="@Url.Action("ResetAdminPassword", new { id = row.AdminID })" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-warning"
                                            onclick="return qcuConfirm(this, { tone: 'warning', title: 'Reset this password?', message: 'A new temporary password will be generated and shown on this page.', confirmText: 'Reset password' });">Reset Password</button>
                                </form>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    }
</div>
<p class="text-muted">
    You cannot disable your own account, and at least one active admin must always remain.
    Accounts are disabled instead of deleted so the history stays intact. To change your own password, use Change Password.
</p>

@Html.Partial("~/Views/Admin/_QCU-CRAM_SetupModal.cshtml", new BSIT3D_GUADES_Project_MVC.QCUCRAM_ViewModels.QCUCRAM_SetupModalViewModel
{
    Open = Model.ModalOpen,
    Title = modalTitle,
    Action = Url.Action("SaveAdmin"),
    Error = Model.ModalError,
    SubmitText = isNew ? "Add Admin" : "Update Admin",
    Needs = isNew ? "#Username|#FullName" : "#FullName",
    CancelUrl = Url.Action("AdminUsers"),
    Body = @<text>
        <input type="hidden" name="AdminID" value="@(isNew ? 0 : Model.Edit.AdminID)" />

        @if (isNew)
        {
            @* Username: only when ADDING (a username cannot be changed afterwards) *@
            <div class="mb-3">
                <label class="form-label" for="Username">Username</label>
                <input id="Username" name="Username" class="form-control" maxlength="50" autocomplete="off"
                       value="@(Model.Edit == null ? string.Empty : Model.Edit.Username)" />
                @foreach (string m in userErrors) { <span class="text-danger">@m</span> }
            </div>
        }

        <div class="mb-3">
            <label class="form-label" for="FullName">Full Name</label>
            <input id="FullName" name="FullName" class="form-control" maxlength="120" autocomplete="off"
                   value="@(Model.Edit == null ? string.Empty : Model.Edit.FullName)" />
            @foreach (string m in nameErrors) { <span class="text-danger">@m</span> }
        </div>

        @if (isNew)
        {
            @* Temporary password: only when ADDING. It is generated automatically (admin1, admin2, ...). *@
            <div class="qcu-temp-note">
                <strong>Temporary password:</strong> <code>@Model.NextTemporaryPassword</code>
                <div class="form-text mb-0">Created automatically (admin + the account's number). Give it to the new library assistant and ask them to change it after logging in.</div>
            </div>
        }
    </text>
})
