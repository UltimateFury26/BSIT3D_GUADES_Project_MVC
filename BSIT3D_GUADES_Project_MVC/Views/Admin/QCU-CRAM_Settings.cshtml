@model BSIT3D_GUADES_Project_MVC.QCUCRAM_ViewModels.QCUCRAMSettingsViewModel
@using System
@{
    /* =====================================================================
       QCU-CRAM  |  Views/Admin/QCU-CRAM_Settings.cshtml
       ---------------------------------------------------------------------
       One-to-one port of Guades_QCUCram_Admin/Guades_QCUCram_Settings.aspx.

       Phase 25 parity points:
         * same heading / sub-heading,
         * same empty-state sentence ("No settings found. Run the seed script."),
         * one row per setting with the value in a whole-number box, the
           description and the "Whole number from X to Y." range note,
         * same "Save Settings" caption and the developer-clock footnote,
         * the server re-checks every value and only writes the ones that
           actually changed ("No changes to save." / "Settings saved (N changed).").
       ===================================================================== */

    ViewBag.Title = "Settings";
    Layout = "~/Views/Shared/_QCU-CRAM_Layout.cshtml";
}

<div class="qcu-page-head">
    <div>
        <h1 class="qcu-page-title">Settings</h1>
        <p class="qcu-page-sub">System rules and limits</p>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Error))
{
    <div class="qcu-alert qcu-alert--error" role="alert">@Model.Error</div>
}

@using (Html.BeginForm("Settings", "AdminSetup", FormMethod.Post, new { @class = "qcu-form" }))
{
    @Html.AntiForgeryToken()

    <section class="qcu-panel">
        @if (Model.Rows.Count == 0)
        {
            <p class="qcu-empty">No settings found. Run the seed script.</p>
        }
        else
        {
            <table class="qcu-table qcu-table--kv">
                <thead>
                    <tr>
                        <th>Setting</th>
                        <th>Value</th>
                        <th>Description</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        <tr>
                            <td><strong>@row.Key</strong></td>
                            <td>
                                <input type="number" class="form-control qcu-input--num"
                                       name="s_@row.Key" value="@row.Value"
                                       min="@row.Min" max="@row.Max" step="1" maxlength="9"
                                       required="required" aria-label="@row.Key" />
                            </td>
                            <td>
                                @row.Description
                                <div class="text-muted small">@row.RangeText</div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>

    <div class="qcu-form__actions">
        <button type="submit" class="qcu-btn qcu-btn--primary">Save Settings</button>
        <a class="qcu-btn qcu-btn--ghost" href="@Url.Action("Settings")">Discard changes</a>
    </div>

    <p class="qcu-hint">
        <strong>DevTimeOffsetMinutes</strong> is for testing only: it shifts the system clock so
        you can test forfeiture and restrictions without waiting. Keep it at 0 for normal use.
        While it is not 0, a red banner shows on every page.
    </p>
}
