@model BSIT3D_GUADES_Project_MVC.QCUCRAM_ViewModels.QCUCRAMSettingsViewModel
@{
    /* =====================================================================
       QCU-CRAM  |  Views/Admin/QCU-CRAM_Settings.cshtml
       One-to-one port of Guades_QCUCram_Admin/Guades_QCUCram_Settings.aspx:
       same page head, GridView table classes, Setting / Value / Description
       columns, text-box width and length, "Save Settings" button with the
       "Please wait..." behaviour, and the DevTimeOffsetMinutes footnote.

       R06 notes:
         * The rows are the rows of the Settings table (EmptyDataText when none).
         * RequiredFieldValidator / RangeValidator -> browser validation
           (required, min, max, step) showing the same "Required." and
           "Whole number from X to Y." texts; the server re-checks everything
           and answers with the original messages as toasts.
       ===================================================================== */
    ViewBag.Title = "Settings";
    Layout = "~/Views/Shared/_QCU-CRAM_Layout.cshtml";
}

<div class="qcu-page-head">
    <h2>Settings</h2>
    <p>System rules and limits</p>
</div>

@using (Html.BeginForm("Settings", "AdminSetup", FormMethod.Post))
{
    @Html.AntiForgeryToken()

    <div class="table-responsive">
        @if (Model.Rows.Count == 0)
        {
            @* GridView EmptyDataText: just the message, no header row *@
            <table class="table table-bordered table-striped qcu-admin-table">
                <tr><td>No settings found. Run the seed script.</td></tr>
            </table>
        }
        else
        {
            <table class="table table-bordered table-striped qcu-admin-table">
                <thead>
                    <tr><th>Setting</th><th>Value</th><th>Description</th></tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        <tr>
                            <td><strong>@row.Key</strong></td>
                            <td>
                                <input type="number" name="s_@row.Key" class="form-control" style="width:150px;"
                                       maxlength="9" min="@row.Min" max="@row.Max" step="1" required="required"
                                       value="@row.Value"
                                       oninvalid="this.setCustomValidity(this.validity.valueMissing ? 'Required.' : '@row.RangeText')"
                                       oninput="this.setCustomValidity('')" />
                            </td>
                            <td>
                                @row.Description
                                <div class="text-muted small">@row.RangeText</div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    <input type="submit" value="Save Settings" class="btn btn-primary"
           onclick="if (!this.form.checkValidity()) { return true; } this.disabled = true; this.value = 'Please wait...'; this.form.submit(); return false;" />
}

<p class="text-muted mt-3">
    <strong>DevTimeOffsetMinutes</strong> is for testing only: it shifts the system clock so you can test forfeiture
    and restrictions without waiting. Keep it at 0 for normal use. While it is not 0, a red banner shows on every page.
</p>
