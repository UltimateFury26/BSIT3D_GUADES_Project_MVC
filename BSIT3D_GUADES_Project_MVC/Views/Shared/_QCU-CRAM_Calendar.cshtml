@model BSIT3D_GUADES_Project_MVC.QCUCRAM_ViewModels.QCUCRAMCalendarViewModel
@using System
@using System.Linq
@{
    /* =====================================================================
       QCU-CRAM  |  Views/Shared/_QCU-CRAM_Calendar.cshtml
       ---------------------------------------------------------------------
       Replaces the <asp:Calendar ID="calBookings"> on
       Guades_QCUCram_Student/Guades_QCUCram_Dashboard.aspx.

       The Web Forms control filled _dayRank / _dayTips in Page_Load and read
       them back in DayRender. Here QCUCRAMStudentService.BuildCalendar has
       already produced one QCUCRAMCalendarDay per visible cell, including the
       blanks that pad the first and last week, so this partial only paints.

       Usage:
           @Html.Partial("_QCU-CRAM_Calendar", Model.Calendar)

       Rank colours, identical to the original legend. The class names are the
       ones the original code-behind used; Content/QCU-CRAM_Site.css repaints
       them so the rendered colours match the legend below:
           3  bg-primary    ongoing  (checked in, slot running now)  -> orange
           2  bg-success    reserved (pending / approved / reassigned) -> blue
           1  bg-secondary  done     (completed)                      -> grey
           0  -             nothing
       ===================================================================== */

    if (Model == null || Model.Days == null || Model.Days.Count == 0)
    {
        <p class="text-muted mb-0">No calendar to show.</p>
        return;
    }

    var days = Model.Days;
    var weeks = (int)Math.Ceiling(days.Count / 7.0);
}

<div class="qcu-cal-wrap">

    <div class="qcu-cal-nav">
        <a class="btn btn-sm btn-outline-secondary"
           href="@Url.Action("Dashboard", "Student", new { month = Model.PreviousMonth.ToString("yyyy-MM") })"
           title="Previous month" aria-label="Previous month">&laquo;</a>

        <span class="qcu-cal-title">@Model.MonthLabel</span>

        <a class="btn btn-sm btn-outline-secondary"
           href="@Url.Action("Dashboard", "Student", new { month = Model.NextMonth.ToString("yyyy-MM") })"
           title="Next month" aria-label="Next month">&raquo;</a>
    </div>

    <table class="qcu-cal table table-bordered text-center mb-2">
        <thead>
            <tr>
                <th scope="col">Sun</th>
                <th scope="col">Mon</th>
                <th scope="col">Tue</th>
                <th scope="col">Wed</th>
                <th scope="col">Thu</th>
                <th scope="col">Fri</th>
                <th scope="col">Sat</th>
            </tr>
        </thead>
        <tbody>
            @for (var week = 0; week < weeks; week++)
            {
                <tr>
                    @for (var dow = 0; dow < 7; dow++)
                    {
                        var index = (week * 7) + dow;

                        if (index >= days.Count)
                        {
                            <td class="qcu-cal-blank"></td>
                            continue;
                        }

                        var day = days[index];

                        if (!day.InMonth)
                        {
                            <td class="qcu-cal-blank"></td>
                            continue;
                        }

                        var css = day.CssClass;
                        var classes = "qcu-cal-day" + (day.IsToday ? " qcu-cal-today" : string.Empty)
                                    + (string.IsNullOrEmpty(css) ? string.Empty : " " + css);

                        <td class="@classes"
                            title="@(string.IsNullOrWhiteSpace(day.Tip) ? null : day.Tip)"
                            data-qcu-day="@day.Date.ToString("yyyy-MM-dd")"
                            data-qcu-bookings="@day.BookingCount">
                            <span class="qcu-cal-num">@day.DayNumber</span>
                            @if (day.BookingCount > 1)
                            {
                                <span class="qcu-cal-count">@day.BookingCount</span>
                            }
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>

    <div class="small qcu-cal-legend">
        <span class="badge bg-success">Reserved</span> pending / approved / reassigned &nbsp;
        <span class="badge bg-primary">Ongoing</span> checked in &nbsp;
        <span class="badge bg-secondary">Done</span> completed
    </div>
    <div class="small text-muted mt-1">Today is outlined in orange. Hover a coloured day for details.</div>
</div>
