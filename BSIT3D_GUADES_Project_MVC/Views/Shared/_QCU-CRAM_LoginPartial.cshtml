@using System
@using BSIT3D_GUADES_Project_MVC.QCUCRAM_Security
@{
    /* =====================================================================
       QCU-CRAM  |  Views/Shared/_QCU-CRAM_LoginPartial.cshtml
       ---------------------------------------------------------------------
       Port of the two <ul> blocks in Guades_QCUCram_Site.Master:

           LEFT  (ul.navbar-nav.me-auto)  page links
           RIGHT (ul.navbar-nav.qcu-nav-right) account area

       The master's phGuest / phStudent / phAdmin / phStudentRight /
       phAdminRight / phUser placeholders become @if blocks driven by
       QCUCRAM_Session - the same three session keys the master read.

       showUnbuiltNav mirrors the flag in _QCU-CRAM_Layout.cshtml: links to
       controllers that arrive in Phase 06+ stay hidden until they exist,
       so the menu never sends the user to a 404.
       ===================================================================== */

    var isStudent = QCUCRAM_Session.IsStudent;
    var isAdmin = QCUCRAM_Session.IsAdmin;
    var isAuthed = isStudent || isAdmin;

    var userName = QCUCRAM_Session.UserName ?? string.Empty;
    var roleName = QCUCRAM_Session.Role ?? string.Empty;

    var unread = (ViewBag.QCUCRAM_UnreadCount is int) ? (int)ViewBag.QCUCRAM_UnreadCount : 0;

    var showUnbuiltNav = true;
}

@* =====================  LEFT: page links  ===================== *@
<ul class="navbar-nav me-auto">

    @* ---- Logged out (master: phGuest) ---- *@
    @if (!isAuthed)
    {
        <li class="nav-item"><a class="nav-link" href="@Url.Action("Login", "Account")">Login</a></li>
        <li class="nav-item"><a class="nav-link" href="@Url.Action("Register", "Account")">Register</a></li>
    }

    @* ---- Student / Faculty / Visitor (master: phStudent) ---- *@
    @if (isStudent)
    {
        <li class="nav-item"><a class="nav-link" href="@Url.Action("Dashboard", "Student")">Dashboard</a></li>

        if (showUnbuiltNav)
        {
            <li class="nav-item"><a class="nav-link" href="@Url.Action("Index", "Availability")">Availability</a></li>
            <li class="nav-item"><a class="nav-link" href="@Url.Action("Reserve", "Student")">Reserve</a></li>
            <li class="nav-item"><a class="nav-link" href="@Url.Action("MyReservations", "Student")">My Reservations</a></li>
        }
    }

    @* ---- Library Assistant (master: phAdmin) ---- *@
    @if (isAdmin)
    {
        <li class="nav-item"><a class="nav-link" href="@Url.Action("Dashboard", "Admin")">Dashboard</a></li>

        if (showUnbuiltNav)
        {
            <li class="nav-item"><a class="nav-link" href="@Url.Action("Index", "Availability")">Availability</a></li>
            <li class="nav-item"><a class="nav-link" href="@Url.Action("Queue", "Admin")">Review Queue</a></li>
            <li class="nav-item"><a class="nav-link" href="@Url.Action("CheckIn", "Admin")">Check-In</a></li>
            <li class="nav-item"><a class="nav-link" href="@Url.Action("Index", "AdminRecords")">Records</a></li>
            <li class="nav-item"><a class="nav-link" href="@Url.Action("Index", "AdminRestrictions")">Restrictions</a></li>
            <li class="nav-item"><a class="nav-link" href="@Url.Action("Analytics", "Reports")">Reports</a></li>
            <li class="nav-item"><a class="nav-link" href="@Url.Action("DailySchedule", "Reports")">Daily Schedule</a></li>
        }
    }

</ul>

@* ===============  RIGHT: account area  =============== *@
<ul class="navbar-nav qcu-nav-right">

    @* ---- Student side: Notifications (bell) + Profile (master: phStudentRight) ---- *@
    @if (isStudent)
    {
        if (showUnbuiltNav)
        {
            <li class="nav-item">
                <a class="nav-link qcu-nav-icon" href="@Url.Action("Notifications", "Student")"
                   title="Notifications" aria-label="Notifications">
                    <svg class="qcu-ico" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9" /><path d="M13.7 21a2 2 0 0 1-3.4 0" /></svg><span class="qcu-nav-label">Notifications</span>
                    @if (unread > 0)
                    {
                        <span class="qcu-nav-badge" aria-label="@unread unread">@(unread > 99 ? "99+" : unread.ToString())</span>
                    }
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="@Url.Action("Profile", "Student")" data-qcu-also="changepassword">
                    <svg class="qcu-ico" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg><span>Profile</span>
                </a>
            </li>
        }
    }

    @* ---- Admin side: Maintenance dropdown (master: phAdminRight) ---- *@
    @if (isAdmin)
    {
        if (showUnbuiltNav)
        {
            <li class="nav-item dropdown">
                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <svg class="qcu-ico" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09a1.65 1.65 0 0 0-1-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09a1.65 1.65 0 0 0 1.51-1 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33h0a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51h0a1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82v0a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" /></svg><span>Maintenance</span>
                </a>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li><a class="dropdown-item" href="@Url.Action("Rooms", "AdminSetup")">Rooms</a></li>
                    <li><a class="dropdown-item" href="@Url.Action("TimeSlots", "AdminSetup")">Time Slots</a></li>
                    <li><a class="dropdown-item" href="@Url.Action("Students", "AdminSetup")">Students</a></li>
                    <li><a class="dropdown-item" href="@Url.Action("AdminUsers", "AdminSetup")">Admin Accounts</a></li>
                    <li><a class="dropdown-item" href="@Url.Action("Settings", "AdminSetup")">Settings</a></li>
                    <li><a class="dropdown-item" href="@Url.Action("DevTools", "AdminSetup")">Dev Tools</a></li>
                    <li><hr class="dropdown-divider" /></li>
                    <li>
                        <a class="dropdown-item" href="@Url.Action("ChangePassword", "Account")"
                           onclick="return qcuConfirm(this, { tone: 'primary', title: 'Change your password?', message: 'You will be taken to the Change Password page.', confirmText: 'Continue' });">Change Password</a>
                    </li>
                </ul>
            </li>
        }
    }

    @* ---- Both roles: who is signed in + logout icon (master: phUser) ---- *@
    @if (isAuthed)
    {
        <li class="nav-item qcu-nav-user">
            <span class="navbar-text">
                Logged in as
                <span class="qcu-user-name">@userName</span>
                <span class="qcu-user-role">@roleName</span>
            </span>
        </li>
        <li class="nav-item">
            <a class="nav-link qcu-nav-icon qcu-nav-logout" href="@Url.Action("Logout", "Account")"
               title="Log out" aria-label="Log out"
               onclick="return qcuConfirm(this, { tone: 'warning', title: 'Log out?', message: 'You will be signed out of QCU-CRAM.', confirmText: 'Log out' });">
                <svg class="qcu-ico" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /><polyline points="16 17 21 12 16 7" /><line x1="21" y1="12" x2="9" y2="12" /></svg><span class="qcu-nav-label">Log out</span>
            </a>
        </li>
    }

</ul>
