@model BSIT3D_GUADES_Project_MVC.QCUCRAM_ViewModels.QCUCRAMPagerViewModel
@using System
@{
    /* =====================================================================
       QCU-CRAM  |  Views/Shared/_QCU-CRAM_Pager.cshtml
       ---------------------------------------------------------------------
       Usage from a view:

           @Html.Partial("_QCU-CRAM_Pager", Model.Pager)

       Renders nothing when there is only one page, so a list view never
       shows a lonely "1".

       Markup matches the Web Forms GridView numeric pager
       (PagerStyle CssClass="qcu-pager", PageButtonCount = 10): a soft bar
       with a centred row of numbered buttons and "..." jumps to the
       neighbouring block. The same markup is written inline in
       MyReservations / Notifications, so every list looks the same.
       ===================================================================== */

    if (Model == null || !Model.HasPages)
    {
        return;
    }

    var total = Model.TotalPages;
    var current = Model.Page < 1 ? 1 : (Model.Page > total ? total : Model.Page);

    const int blockSize = 10;
    var first = ((current - 1) / blockSize) * blockSize + 1;
    var last = Math.Min(first + blockSize - 1, total);
}

<div class="qcu-pager qcu-pager-block">
    <table>
        <tbody>
            <tr>
                @if (first > 1)
                {
                    <td><a href="@Model.UrlFor(first - 1)">...</a></td>
                }
                @for (var p = first; p <= last; p++)
                {
                    if (p == current)
                    {
                        <td><span>@p</span></td>
                    }
                    else
                    {
                        <td><a href="@Model.UrlFor(p)">@p</a></td>
                    }
                }
                @if (last < total)
                {
                    <td><a href="@Model.UrlFor(last + 1)">...</a></td>
                }
            </tr>
        </tbody>
    </table>
</div>
