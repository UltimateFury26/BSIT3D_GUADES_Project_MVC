@model string
@using System
@{
    /* =====================================================================
       QCU-CRAM  |  Views/Shared/_QCU-CRAM_StatusBadge.cshtml
       ---------------------------------------------------------------------
       Usage:  @Html.Partial("_QCU-CRAM_StatusBadge", row.Status)

       The model is the raw status string from the Reservations table
       (QCUCRAM_Status.Pending / Approved / Reassigned / Declined /
       Cancelled / CheckedIn / Completed / Forfeited).

       Emits exactly the same markup as the Web Forms StatusBadge() helpers
       (Records.aspx.cs, Dashboard.aspx.cs, MyReservations.aspx.cs):
           <span class="badge bg-warning text-dark">Pending</span>
       so the pills keep the Bootstrap colours used across the Web Forms app.
       ===================================================================== */

    var status = Convert.ToString(Model ?? string.Empty).Trim();

    string css;
    switch (status)
    {
        case "Pending": css = "bg-warning text-dark"; break;
        case "Approved": css = "bg-success"; break;
        case "Reassigned": css = "bg-info text-dark"; break;
        case "Declined": css = "bg-danger"; break;
        case "Cancelled": css = "bg-secondary"; break;
        case "CheckedIn": css = "bg-primary"; break;
        case "Completed": css = "bg-dark"; break;
        case "Forfeited": css = "bg-danger"; break;
        default: css = "bg-light text-dark"; break;
    }

    var label = status == "CheckedIn" ? "Checked In"
              : string.IsNullOrEmpty(status) ? "Unknown"
              : status;
}

<span class="badge @css">@label</span>
