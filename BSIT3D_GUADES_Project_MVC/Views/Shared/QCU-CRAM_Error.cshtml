@{
    /* =====================================================================
       QCU-CRAM  |  Views/Shared/QCU-CRAM_Error.cshtml
       ---------------------------------------------------------------------
       The friendly error page used when an unhandled exception reaches MVC
       (App_Start/FilterConfig.cs registers HandleErrorAttribute, and
       Global.asax.cs Application_Error writes App_Data/QCU-CRAM_error.log).

       Views/Error/Index.cshtml (Phase 04) stays the page the ErrorController
       returns; this shared copy is the fallback the framework can render on
       its own, and it is the one the Razor layout styles.

       Never show the exception text here - only the reference id.
       ===================================================================== */

    Layout = "~/Views/Shared/_QCU-CRAM_Layout.cshtml";
    ViewBag.Title = "Something went wrong";

    var reference = Convert.ToString(ViewBag.QCUCRAM_ErrorReference ?? string.Empty);
}

<div class="qcu-card p-4 text-center">
    <h1 class="h4 mb-2">Something went wrong</h1>

    <p class="text-muted mb-3">
        The QCU-CRAM system hit an unexpected error. The details have been logged.
    </p>

    @if (!string.IsNullOrWhiteSpace(reference))
    {
        <p class="text-muted small mb-3">
            Reference: <code>@reference</code> &mdash; quote this when you report the problem.
        </p>
    }

    <div class="d-flex gap-2 justify-content-center">
        <a class="btn btn-primary" href="@Url.Action("Index", "Home")">Back to home</a>
        <a class="btn btn-outline-secondary" href="@Url.Action("Login", "Account")">Sign in again</a>
    </div>
</div>
