@model BSIT3D_GUADES_Project_MVC.QCUCRAM_ViewModels.QCUCRAMErrorViewModel
@using BSIT3D_GUADES_Project_MVC.QCUCRAM_Security
@{
    /* =====================================================================
       QCU-CRAM  |  Views/Shared/QCU-CRAM_Error.cshtml
       ---------------------------------------------------------------------
       The single friendly error page. Rendered by QCUCRAMHandleErrorAttribute
       for unhandled exceptions and by ErrorController for a direct /error hit.

       Never show a stack trace to the user - only the reference code. The
       detail block appears only when QCU-CRAM_ShowErrorDetail is "true" in
       Web.config, which is a local-debugging switch.
       ===================================================================== */

    Layout = "~/Views/Shared/_QCU-CRAM_Layout.cshtml";
    ViewBag.Title = Model.Title;

    bool signedIn = QCUCRAM_Session.IsAuthenticated;
    string homeUrl = signedIn
        ? Url.Content(QCUCRAM_Session.HomeFor(QCUCRAM_Session.Role))
        : Url.Action("Login", "Account");
}

@section head {
    <meta name="robots" content="noindex, nofollow" />
}

<div class="qcu-panel qcu-error">
    <div class="qcu-error__code">@Model.StatusCode</div>
    <h1 class="qcu-error__title">@Model.Title</h1>
    <p class="qcu-error__message">@Model.Message</p>

    @if (!string.IsNullOrWhiteSpace(Model.Reference))
    {
        <p class="qcu-error__ref">
            Reference: <code class="qcu-qcid">@Model.Reference</code>
        </p>
    }

    <div class="qcu-toolbar">
        <a class="btn btn-primary" href="@homeUrl">
            @(signedIn ? "Back to dashboard" : "Go to login")
        </a>
        <a class="btn btn-outline-secondary" href="@Url.Action("Index", "Home")">Home</a>
        <button type="button" class="btn btn-outline-secondary" onclick="history.back();">Go back</button>
    </div>

    @if (Model.ShowDetail && !string.IsNullOrWhiteSpace(Model.Detail))
    {
        <details class="qcu-error__detail">
            <summary>Technical detail (development only)</summary>
            <pre>@Model.Detail</pre>
        </details>
    }
</div>
