@model BSIT3D_GUADES_Project_MVC.QCUCRAM_ViewModels.QCUCRAM_RegisterViewModel
@{
    ViewBag.Title = "Register";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="card shadow-sm mt-4">
            <div class="card-body p-4">
                <h1 class="h4 mb-1">Create an account</h1>
                <p class="text-muted small mb-4">Students, faculty and visitors all register here.</p>

                @using (Html.BeginForm("Register", "Account", FormMethod.Post, new { @class = "row g-3", novalidate = "novalidate" }))
                {
                    @Html.AntiForgeryToken()

                    <div class="col-12">
                        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger py-2" })
                    </div>

                    <div class="col-12">
                        @Html.LabelFor(m => m.RequesterType, new { @class = "form-label" })
                        @Html.DropDownListFor(m => m.RequesterType,
                            new SelectList(Model.RequesterTypeChoices, Model.RequesterType),
                            new { @class = "form-select", id = "requesterType" })
                        @Html.ValidationMessageFor(m => m.RequesterType, "", new { @class = "text-danger small" })
                    </div>

                    <div class="col-12">
                        @Html.LabelFor(m => m.StudentNumber, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.StudentNumber, new
                        {
                            @class = "form-control",
                            placeholder = "23-0001",
                            autocomplete = "off"
                        })
                        @Html.ValidationMessageFor(m => m.StudentNumber, "", new { @class = "text-danger small" })
                    </div>

                    <div class="col-12 col-md-5">
                        @Html.LabelFor(m => m.LastName, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.LastName, new { @class = "form-control", autocomplete = "family-name" })
                        @Html.ValidationMessageFor(m => m.LastName, "", new { @class = "text-danger small" })
                    </div>

                    <div class="col-12 col-md-5">
                        @Html.LabelFor(m => m.FirstName, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.FirstName, new { @class = "form-control", autocomplete = "given-name" })
                        @Html.ValidationMessageFor(m => m.FirstName, "", new { @class = "text-danger small" })
                    </div>

                    <div class="col-12 col-md-2">
                        @Html.LabelFor(m => m.MI, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.MI, new { @class = "form-control", maxlength = "2", autocomplete = "off" })
                        @Html.ValidationMessageFor(m => m.MI, "", new { @class = "text-danger small" })
                    </div>

                    <div class="col-12">
                        @Html.LabelFor(m => m.Email, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email", autocomplete = "email" })
                        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
                    </div>

                    <div class="col-12">
                        @Html.LabelFor(m => m.Program, new { @class = "form-label" })
                        @Html.DropDownListFor(m => m.Program,
                            new SelectList(Model.ProgramChoices, Model.Program),
                            "-- select your program --",
                            new { @class = "form-select" })
                        @Html.ValidationMessageFor(m => m.Program, "", new { @class = "text-danger small" })
                    </div>

                    <div class="col-12 col-md-6">
                        @Html.LabelFor(m => m.Password, new { @class = "form-label" })
                        @Html.PasswordFor(m => m.Password, new { @class = "form-control", autocomplete = "new-password" })
                        @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small" })
                    </div>

                    <div class="col-12 col-md-6">
                        @Html.LabelFor(m => m.ConfirmPassword, new { @class = "form-label" })
                        @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", autocomplete = "new-password" })
                        @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger small" })
                    </div>

                    <div class="col-12 d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Register</button>
                        @Html.ActionLink("Back to log in", "Login", "Account", null, new { @class = "btn btn-outline-secondary" })
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        // A student number is only required for students; faculty and visitors may
        // use an employee number or any ID. The server re-checks this anyway.
        (function () {
            var type = document.getElementById('requesterType');
            var number = document.getElementById('StudentNumber');
            if (!type || !number) { return; }

            function refresh() {
                var isStudent = type.value === 'Student';
                number.setAttribute('placeholder', isStudent ? '23-0001' : 'employee number / ID');
            }

            type.addEventListener('change', refresh);
            refresh();
        })();
    </script>
}
