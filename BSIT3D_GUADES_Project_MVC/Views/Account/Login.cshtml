@model BSIT3D_GUADES_Project_MVC.QCUCRAM_ViewModels.QCUCRAM_LoginViewModel
@using System
@{
    /* =====================================================================
       QCU-CRAM  |  Views/Account/Login.cshtml
       ---------------------------------------------------------------------
       Port of Guades_QCUCram_Account/Guades_QCUCram_Login.aspx.

       The Web Forms page was a .qcu-auth card with:
         * the QCU seal in a blue/orange header band,
         * "Quezon City University" / "Login" / "Sign in to reserve a
           collaboration room",
         * a two-option role picker ("Student / Faculty / Visitor" vs
           "Library Assistant") rendered as side-by-side pills,
         * a first field that switches between "Student Number / ID" and
           "Username" (with the 23-0001 dash auto-format for students),
         * a full-width Login button and a "Create an account" link.

       Everything below keeps that markup and that behaviour. The only
       change is that the ASP.NET validators became unobtrusive jQuery
       validation attributes on the view model.
       ===================================================================== */

    ViewBag.Title = "Login";
    Layout = "~/Views/Shared/_QCU-CRAM_LoginLayout.cshtml";
}

<div class="qcu-auth-card">
    <div class="qcu-auth-head">
        <img src="@Url.Content("~/Content/images/QCU-CRAM_qcu-logo.png")" alt="QCU Seal" />
        <div class="qcu-auth-univ">Quezon City University</div>
        <h2>Login</h2>
        <p>Sign in to reserve a collaboration room</p>
    </div>

    <div class="qcu-auth-body">

        @* Phase 07: the original showed lblMessage as the upper-right toast, not an in-card alert.
           The layout suppresses its own toast on Login, so the view renders it once, here. *@
        @Html.Partial("_QCU-CRAM_Toast")

        @using (Html.BeginForm("Login", "Account", FormMethod.Post, new { @class = "qcu-auth-form", novalidate = "novalidate" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.ReturnUrl)

            <div class="mb-3">
                <span class="form-label d-block">Sign in as</span>
                <div class="form-check">
                    @Html.RadioButtonFor(m => m.Role, "Student", new { id = "roleStudent" })
                    <label for="roleStudent">Student / Faculty / Visitor</label>

                    @Html.RadioButtonFor(m => m.Role, "Admin", new { id = "roleAdmin" })
                    <label for="roleAdmin">Library Assistant</label>
                </div>
            </div>

            <div class="mb-3">
                <label id="lblLoginId" for="Identifier" class="form-label">@Model.IdentifierLabel</label>
                @Html.TextBoxFor(m => m.Identifier, new
                {
                    @class = "form-control",
                    maxlength = "50",
                    autocomplete = "username",
                    placeholder = Model.IdentifierPlaceholder,
                    autofocus = "autofocus"
                })
                @Html.ValidationMessageFor(m => m.Identifier, string.Empty, new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.Password, new { @class = "form-label" })
                @Html.PasswordFor(m => m.Password, new
                {
                    @class = "form-control",
                    maxlength = "100",
                    autocomplete = "current-password"
                })
                @Html.ValidationMessageFor(m => m.Password, string.Empty, new { @class = "text-danger" })
            </div>

            <button type="submit" id="btnLogin" class="btn btn-primary">Login</button>

            <a href="@Url.Action("Register", "Account")" class="btn btn-link">Create an account</a>
        }

    </div>
</div>

@section scripts {
    <script>
        // "Please wait..." on Login. This used to be an inline onclick that disabled the
        // button; a browser skips the form submit when the submit button is disabled before
        // the click finishes, so the page just sat on "Please wait...". Disabling it from the
        // form's submit event is safe because the submit is already under way.
        (function () {
            var btn = document.getElementById('btnLogin');
            var form = btn ? btn.form : null;
            if (!btn || !form) { return; }

            form.addEventListener('submit', function () {
                if (window.jQuery && jQuery.fn.valid && !jQuery(form).valid()) { return; }
                btn.disabled = true;
                btn.textContent = 'Please wait...';
            });

            // Back / forward cache: never come back to a stuck "Please wait..." button.
            window.addEventListener('pageshow', function () {
                btn.disabled = false;
                btn.textContent = 'Login';
            });
        })();

        // Role picker changes the first field: "Student Number / ID" (dash
        // auto-format) vs "Username" (plain text). Same behaviour as the
        // ApplyRoleLabels() helper on the Web Forms page.
        (function () {
            var student = document.getElementById('roleStudent');
            var admin = document.getElementById('roleAdmin');
            var id = document.getElementById('Identifier');
            var label = document.getElementById('lblLoginId');
            if (!id || !label) { return; }

            function isAdmin() {
                return !!(admin && admin.checked);
            }

            // The Web Forms RequiredFieldValidator swapped its own text with the role, so the
            // unobtrusive rule and any message already on screen are swapped the same way.
            var idMsg = document.querySelector('[data-valmsg-for="Identifier"]');

            function requiredText(a) {
                return a ? 'Username is required.' : 'Student number / ID is required.';
            }

            function apply(clear) {
                var a = isAdmin();
                label.textContent = a ? 'Username' : 'Student Number / ID';
                id.placeholder = a ? 'username' : '23-0001';
                id.setAttribute('autocomplete', 'username');
                id.setAttribute('data-val-required', requiredText(a));
                if (idMsg && idMsg.textContent) { idMsg.textContent = requiredText(a); }
                if (clear) { id.value = ''; }   // a half-typed "23-" must not carry over
            }

            if (student) { student.addEventListener('change', function () { apply(true); }); }
            if (admin) { admin.addEventListener('change', function () { apply(true); }); }

            if (window.Qcu && Qcu.attachDash) {
                Qcu.attachDash(id, { enabled: function () { return !isAdmin(); } });
            }

            apply(false);
        })();
    </script>
}
