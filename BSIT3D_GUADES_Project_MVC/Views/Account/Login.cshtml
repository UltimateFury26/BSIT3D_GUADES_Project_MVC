@model BSIT3D_GUADES_Project_MVC.QCUCRAM_ViewModels.QCUCRAM_LoginViewModel
@{
    ViewBag.Title = "Log In";
    Layout = "~/Views/Shared/_QCU-CRAM_Layout.cshtml";
    string noticeText = ViewBag.QCUCRAM_NoticeText as string;
    string noticeKind = ViewBag.QCUCRAM_NoticeKind as string;
}

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-5">
        <div class="card shadow-sm mt-4">
            <div class="card-body p-4">
                <h1 class="h4 mb-1">QCU-CRAM</h1>
                <p class="text-muted small mb-4">Collaboration Room Access &amp; Monitoring</p>

                @if (!string.IsNullOrEmpty(noticeText))
                {
                    <div class="alert @(noticeKind == "error" ? "alert-danger" : "alert-success") py-2" role="alert">
                        @noticeText
                    </div>
                }

                @using (Html.BeginForm("Login", "Account", FormMethod.Post, new { @class = "needs-validation", novalidate = "novalidate" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(m => m.ReturnUrl)

                    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger py-2" })

                    <div class="mb-3">
                        <label class="form-label d-block">Account type</label>
                        <div class="form-check form-check-inline">
                            @Html.RadioButtonFor(m => m.Role, "Student", new { @class = "form-check-input", id = "roleStudent" })
                            <label class="form-check-label" for="roleStudent">Student / Faculty / Visitor</label>
                        </div>
                        <div class="form-check form-check-inline">
                            @Html.RadioButtonFor(m => m.Role, "Admin", new { @class = "form-check-input", id = "roleAdmin" })
                            <label class="form-check-label" for="roleAdmin">Library Assistant</label>
                        </div>
                    </div>

                    <div class="mb-3">
                        @Html.LabelFor(m => m.Identifier, Model.IdentifierLabel, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.Identifier, new
                        {
                            @class = "form-control",
                            placeholder = Model.IdentifierPlaceholder,
                            autocomplete = "username",
                            autofocus = "autofocus"
                        })
                        @Html.ValidationMessageFor(m => m.Identifier, "", new { @class = "text-danger small" })
                    </div>

                    <div class="mb-3">
                        @Html.LabelFor(m => m.Password, new { @class = "form-label" })
                        @Html.PasswordFor(m => m.Password, new { @class = "form-control", autocomplete = "current-password" })
                        @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small" })
                    </div>

                    <button type="submit" class="btn btn-primary w-100">Log In</button>
                }

                <hr class="my-4" />
                <p class="small mb-0 text-center">
                    No account yet? @Html.ActionLink("Register here", "Register", "Account")
                </p>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        // Keep the first-field label in step with the radio button, exactly like
        // ApplyRoleLabels() did on the Web Forms page.
        (function () {
            var id = document.getElementById('Identifier');
            if (!id) { return; }
            var student = document.getElementById('roleStudent');
            var admin = document.getElementById('roleAdmin');

            function refresh() {
                var isAdmin = admin && admin.checked;
                var label = document.querySelector('label[for="Identifier"]');
                if (label) { label.textContent = isAdmin ? 'Username' : 'Student Number / ID'; }
                id.setAttribute('placeholder', isAdmin ? 'username' : '23-0001');
            }

            if (student) { student.addEventListener('change', refresh); }
            if (admin) { admin.addEventListener('change', refresh); }
            refresh();
        })();
    </script>
}
