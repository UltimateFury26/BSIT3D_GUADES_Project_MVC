@model BSIT3D_GUADES_Project_MVC.QCUCRAM_ViewModels.QCUCRAM_ChangePasswordViewModel
@using System
@{
    /* =====================================================================
       QCU-CRAM  |  Views/Account/ChangePassword.cshtml
       ---------------------------------------------------------------------
       Phase 04 never shipped this view, but the admin "Maintenance" dropdown
       in _QCU-CRAM_LoginPartial.cshtml already linked to
       Account/ChangePassword, so the link 404'd.

       Same .qcu-auth card as the original Change Password page, so it sits
       comfortably next to Login and Register.
       ===================================================================== */

    ViewBag.Title = "Change Password";
    Layout = "~/Views/Shared/_QCU-CRAM_LoginLayout.cshtml";
}

<div class="qcu-auth-card">
    <div class="qcu-auth-head">
        <img src="@Url.Content("~/Content/images/QCU-CRAM_qcu-logo.png")" alt="QCU Seal" />
        <div class="qcu-auth-univ">Quezon City University</div>
        <h2>Change Password</h2>
        <p>Choose a new password for your QCU-CRAM account</p>
    </div>

    <div class="qcu-auth-body">

        @using (Html.BeginForm("ChangePassword", "Account", FormMethod.Post, new { @class = "qcu-auth-form", novalidate = "novalidate" }))
        {
            @Html.AntiForgeryToken()

            @Html.ValidationSummary(true, string.Empty, new { @class = "alert alert-danger py-2 small" })

            <div class="mb-3">
                @Html.LabelFor(m => m.CurrentPassword, new { @class = "form-label" })
                @Html.PasswordFor(m => m.CurrentPassword, new
                {
                    @class = "form-control",
                    maxlength = "100",
                    autocomplete = "current-password"
                })
                @Html.ValidationMessageFor(m => m.CurrentPassword, string.Empty, new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.NewPassword, new { @class = "form-label" })
                @Html.PasswordFor(m => m.NewPassword, new
                {
                    @class = "form-control",
                    maxlength = "100",
                    autocomplete = "new-password"
                })
                @Html.ValidationMessageFor(m => m.NewPassword, string.Empty, new { @class = "text-danger" })
                <div data-qcu-strength data-input="NewPassword"></div>
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.ConfirmPassword, new { @class = "form-label" })
                @Html.PasswordFor(m => m.ConfirmPassword, new
                {
                    @class = "form-control",
                    maxlength = "100",
                    autocomplete = "new-password"
                })
                @Html.ValidationMessageFor(m => m.ConfirmPassword, string.Empty, new { @class = "text-danger" })
            </div>

            <button type="submit" class="btn btn-primary">Change Password</button>
            <a href="@Url.Content(BSIT3D_GUADES_Project_MVC.QCUCRAM_Security.QCUCRAM_Session.HomeFor(BSIT3D_GUADES_Project_MVC.QCUCRAM_Security.QCUCRAM_Session.Role))"
               class="btn btn-link">Back to my dashboard</a>
        }

    </div>
</div>
